  <key>PayloadDisplayName</key><string>JamfReports — Debug Logging</string>
  <key>PayloadDescription</key><string>Enables verbose (debug/info) log persistence for JamfReports diagnostics. Does not reveal private values — interpolated serials, hostnames, and usernames remain redacted.</string>
