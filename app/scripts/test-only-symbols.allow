# Symbols in app/Sources that only app/Tests reference.
# One name per line as `Name  # reason`; every entry needs a reason.
# Read by app/scripts/check-test-only-symbols.zsh, which warns about an entry
# that no longer matches anything.

# --- Test seams and framework callbacks -------------------------------------
# Deliberate: production code never calls these; tests need them, or the system
# calls them at runtime.
clearVerificationCacheForTesting  # JamfCLIIdentity: resets the codesign verification cache between tests
StubTickerRegistrar               # TickerRegistrar test double; tests run the tick loop against it
invokeRetryForTesting             # ErrorStateView: fires the retry action without a rendered button
controlTextDidChange              # NSTextFieldDelegate method on SecureSecretField's coordinator; AppKit calls it
controlTextDidEndEditing          # NSTextFieldDelegate method on SecureSecretField's coordinator; AppKit calls it

# --- jamf-cli command catalog -------------------------------------------------
isCanonical  # CommandCatalog query: the help-contract test pins which app commands go through an alias
isDestructive  # CommandCatalog query: the help-contract test asserts the app issues no destructive command
isPreview  # CommandCatalog query for the catalog's preview column; read by the catalog tests
privilegesListed  # CommandCatalog query: "lists none" (nil) versus "not in the catalog" (nil path), asserted by the catalog tests
urlSession  # URLSessionTaskDelegate redirect hook in HTTPSession.RedirectRule: URLSession calls it, a test calls it directly
