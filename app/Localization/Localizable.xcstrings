    "%@ cannot be written by your account. On a shared team folder this normally means you have been granted read access rather than edit access." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ kann von Ihrem Account nicht beschrieben werden. In einem geteilten Teamordner bedeutet das normalerweise, dass Ihnen Lese- statt Schreibzugriff gewährt wurde."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Su cuenta no puede escribir en %@. En una carpeta de equipo compartida, normalmente significa que se le ha concedido acceso de lectura en lugar de edición."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre compte ne peut pas écrire dans %@. Sur un dossier d’équipe partagé, cela signifie normalement que vous disposez d’un accès en lecture plutôt qu’en modification."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ non può essere scritto dall’account in uso. Su una cartella di team condivisa di solito significa che è stato concesso l’accesso in lettura anziché in modifica."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "お使いのアカウントでは%@に書き込めません。共有チームフォルダの場合、通常は編集アクセス権ではなく読み取りアクセス権が付与されていることを意味します。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ não pode ser gravado pela sua conta. Em uma pasta de equipe compartilhada, isso normalmente significa que você recebeu acesso de leitura em vez de edição."
          }
        }
      }
    },
