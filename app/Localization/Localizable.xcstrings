    "Keep '%@' as the workspace and exclude '%@' under Automation > Excluded profiles. Keep the oauth2 profile in jamf-cli for the commands the gateway refuses. Nothing is changed for you." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ als Arbeitsbereich beibehalten und „%@“ unter Automatisierung > Ausgeschlossene Profile ausschließen. Das oauth2-Profil in jamf-cli für die Befehle behalten, die das Gateway ablehnt. Es wird nichts für Sie geändert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Keep '%1$@' as the workspace and exclude '%2$@' under Automation > Excluded profiles. Keep the oauth2 profile in jamf-cli for the commands the gateway refuses. Nothing is changed for you."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conserve '%@' como espacio de trabajo y excluya '%@' en Automatización > Perfiles excluidos. Conserve el perfil oauth2 en jamf-cli para los comandos que rechaza la pasarela. No se cambia nada automáticamente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conservez « %@ » comme espace de travail et excluez « %@ » sous Automatisation > Profils exclus. Conservez le profil oauth2 dans jamf-cli pour les commandes que la passerelle refuse. Rien n’est modifié à votre place."
          }
        }
      }
    },
