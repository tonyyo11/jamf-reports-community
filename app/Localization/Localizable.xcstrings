    "For on-prem, GovCloud or any Jamf Pro instance, with an API client (OAuth2). Walks you through jamf-cli auth and workspace setup." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für On-Prem, GovCloud oder jede Jamf Pro-Instanz, mit einem API-Client (OAuth2). Führt Sie durch die jamf-cli-Authentifizierung und die Einrichtung des Arbeitsbereichs."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para instancias locales, GovCloud o cualquier instancia de Jamf Pro, con un cliente de API (OAuth2). Le guía por la autenticación de jamf-cli y la configuración del espacio de trabajo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
