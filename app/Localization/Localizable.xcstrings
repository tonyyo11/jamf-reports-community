    "Optionally connect Jamf Protect. It is skippable — you can add it later from Data Sources. Jamf School uses its own workspace." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbinden Sie optional Jamf Protect. Das ist überspringbar – Sie können es später unter „Datenquellen“ hinzufügen. Jamf School verwendet einen eigenen Arbeitsbereich."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opcionalmente, conecte Jamf Protect. Se puede omitir: puede añadirlo más tarde desde Fuentes de datos. Jamf School usa su propio espacio de trabajo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connectez Jamf Protect si vous le souhaitez. Cette étape est facultative : vous pourrez l’ajouter plus tard depuis Sources de données. Jamf School utilise son propre espace de travail."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Collegamento facoltativo di Jamf Protect. Si può saltare e aggiungere in seguito da Origini dati. Jamf School usa un proprio spazio di lavoro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "必要に応じてJamf Protectを接続できます。省略しても、あとでデータソースから追加できます。Jamf Schoolは専用のワークスペースを使います。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opcionalmente, conecte o Jamf Protect. Pode ser pulado — você pode adicioná-lo depois em Fontes de dados. O Jamf School usa o próprio espaço de trabalho."
          }
        }
      }
    },
