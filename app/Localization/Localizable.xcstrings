    "Jamf Pro workspaces only. Jamf School has no deep scan: its daily collect covers every School source." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur Jamf Pro-Arbeitsbereiche. Jamf School hat keinen Tiefenscan: Die tägliche Erfassung deckt alle School-Quellen ab."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
