    "One per line: the ID, then an optional label (for example \"<id> Production\"). The label names the profile and the sidebar entry." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine pro Zeile: die ID, dann optional ein Label (zum Beispiel „<id> Production“). Das Label benennt das Profil und den Eintrag in der Seitenleiste."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uno por línea: el ID y, opcionalmente, una etiqueta (por ejemplo, “<id> Production”). La etiqueta da nombre al perfil y a la entrada de la barra lateral."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un par ligne : l’ID, puis un libellé facultatif (par exemple « <id> Production »). Le libellé nomme le profil et l’entrée de la barre latérale."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uno per riga: l’ID, seguito da un’etichetta facoltativa (ad esempio “<id> Production”). L’etichetta dà il nome al profilo e alla voce della barra laterale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1行に1件: ID、続けて任意のラベル（例: “<id> Production”）。ラベルはプロファイル名とサイドバーの項目名になります。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um por linha: o ID, seguido de um rótulo opcional (por exemplo, \"<id> Produção\"). O rótulo dá nome ao perfil e à entrada da barra lateral."
          }
        }
      }
    },
