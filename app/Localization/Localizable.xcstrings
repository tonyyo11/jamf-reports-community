    "On %@ — multi-Mac coordination turns on automatically. Run Check on the Config screen reports who else writes here." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf %@ – die Koordination mehrerer Macs wird automatisch eingeschaltet. „Prüfen“ im Konfig-Bereich zeigt, wer sonst hier schreibt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activado en %@: la coordinación entre varios Mac se activa automáticamente. “Ejecutar comprobación” en la pantalla Configuración indica quién más escribe aquí."
          }
        },
        "fr" : {
          "stringUnit" : {
