    "The Overview's EDR card and trend. The score counts agents above." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EDR-Karte und Trend der Übersicht. Der Sicherheitswert zählt die oben aufgeführten Agents."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tarjeta y la tendencia de EDR del Resumen. La puntuación cuenta los agentes indicados arriba."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La carte EDR de la vue d’ensemble et sa tendance. Le score compte les agents ci-dessus."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La scheda EDR e l’andamento della Panoramica. Il punteggio conteggia gli agenti qui sopra."
          }
