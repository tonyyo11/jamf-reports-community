    "Scheduled backups that already ran here continue for %lld runs, then skip Jamf Pro and read as Partial." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geplante Backups, die hier bereits liefen, werden noch %lld Läufe fortgesetzt, überspringen dann Jamf Pro und gelten als Teilweise."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las copias de seguridad programadas que ya se ejecutaron aquí continúan durante %lld ejecuciones; después omiten Jamf Pro y se muestran como Parcial."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les sauvegardes planifiées déjà exécutées ici se poursuivent pendant %lld exécutions, puis ignorent Jamf Pro et sont signalées comme partielles."
          }
        }
      }
    },
    "Scheduled run overdue — %@ should have run %@; last success %@%@." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geplanter Lauf überfällig — %@ hätte %@ laufen sollen; letzter Erfolg %@%@."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Scheduled run overdue — %1$@ should have run %2$@; last success %3$@%4$@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ejecución programada retrasada — %1$@ debería haberse ejecutado %2$@; último éxito %3$@%4$@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exécution planifiée en retard — %@ aurait dû s’exécuter %@ ; dernier succès %@%@."
          }
        }
      }
    },
    "Scheduled runs and the command-line tool write it too." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geplante Läufe und das Befehlszeilenwerkzeug schreiben sie ebenfalls."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "También lo escriben las ejecuciones programadas y la herramienta de línea de comandos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les exécutions planifiées et l’outil en ligne de commande l’écrivent aussi."
          }
        }
      }
    },
    "Scheduled runs are paused until \"Allow in the Background\" is turned on for JamfReports in Login Items." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geplante Läufe sind pausiert, bis „Im Hintergrund erlauben“ für JamfReports unter Anmeldeobjekte aktiviert ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las ejecuciones programadas están en pausa hasta que se active “Permitir en segundo plano” para JamfReports en Ítems de inicio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les exécutions planifiées sont suspendues tant que « Autoriser en arrière-plan » n’est pas activé pour JamfReports dans Ouverture."
          }
        }
      }
    },
    "Scheduled runs post digests and failure alerts to a Teams or Slack incoming webhook. Leave empty to skip; change it anytime under Automation › Notifications." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geplante Läufe senden Digests und Fehlermeldungen an einen eingehenden Webhook von Teams oder Slack. Lassen Sie das Feld leer, um darauf zu verzichten; Änderung jederzeit unter Automatisierung › Benachrichtigungen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las ejecuciones programadas publican resúmenes y alertas de error en un webhook entrante de Teams o Slack. Déjelo vacío para omitirlo; puede cambiarlo en cualquier momento en Automatización › Notificaciones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les exécutions planifiées publient des résumés et des alertes d’échec vers un webhook entrant Teams ou Slack. Laissez vide pour ignorer ; modifiable à tout moment dans Automatisation › Notifications."
          }
        }
      }
    },
    "Scheduled runs post digests, failure alerts, metric alerts, and overdue notices to this webhook." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geplante Läufe senden Zusammenfassungen, Fehlermeldungen, Metrikwarnungen und Überfälligkeitshinweise an diesen Webhook."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las ejecuciones programadas publican resúmenes, alertas de fallo, alertas de métricas y avisos de retraso en este webhook."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les exécutions planifiées publient sur ce webhook des résumés, des alertes d’échec, des alertes de métriques et des avis de retard."
          }
        }
      }
    },
