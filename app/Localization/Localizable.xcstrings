    "Generated reports are written to %@ while the workspace stays on local disk — the narrowest way to share output, since only finished reports leave this Mac." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erstellte Berichte werden nach %@ geschrieben, während der Arbeitsbereich auf der lokalen Festplatte bleibt – die engste Art, Ausgaben zu teilen, da nur fertige Berichte diesen Mac verlassen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los informes generados se escriben en %@ mientras el espacio de trabajo permanece en el disco local: es la forma más restringida de compartir la salida, ya que solo los informes terminados salen de este Mac."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les rapports générés sont écrits dans %@ tandis que l’espace de travail reste sur le disque local — la façon la plus restreinte de partager les sorties, car seuls les rapports terminés quittent ce Mac."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os relatórios gerados são gravados em %@ enquanto o espaço de trabalho permanece no disco local — a forma mais restrita de compartilhar a saída, já que apenas os relatórios finalizados saem deste Mac."
          }
        }
      }
    },
    "Generated reports include every definition." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erstellte Berichte enthalten jede Definition."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los informes generados incluyen todas las definiciones."
          }
        },
        "fr" : {
