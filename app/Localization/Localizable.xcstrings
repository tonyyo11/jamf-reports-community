    "Scheduled backups that already ran here continue for %lld runs, then skip Jamf Pro and read as Partial." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geplante Backups, die hier bereits liefen, werden noch %lld Läufe fortgesetzt, überspringen dann Jamf Pro und gelten als Teilweise."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las copias de seguridad programadas que ya se ejecutaron aquí continúan durante %lld ejecuciones; después omiten Jamf Pro y se muestran como Parcial."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les sauvegardes planifiées déjà exécutées ici se poursuivent pendant %lld exécutions, puis ignorent Jamf Pro et sont signalées comme partielles."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I backup pianificati già eseguiti qui continuano per %lld esecuzioni, poi saltano Jamf Pro e risultano Parziali."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ここですでに実行されたスケジュールバックアップは%lld回続き、その後はJamf Proをスキップして一部成功として扱われます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os backups agendados que já foram executados aqui continuam por %lld execuções, depois ignoram o Jamf Pro e são considerados Parciais."
          }
        }
      }
    },
    "Scheduled run overdue — %@ should have run %@; last success %@%@." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geplanter Lauf überfällig — %@ hätte %@ laufen sollen; letzter Erfolg %@%@."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Scheduled run overdue — %1$@ should have run %2$@; last success %3$@%4$@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ejecución programada retrasada — %1$@ debería haberse ejecutado %2$@; último éxito %3$@%4$@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exécution planifiée en retard — %@ aurait dû s’exécuter %@ ; dernier succès %@%@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esecuzione pianificata in ritardo: %1$@ avrebbe dovuto essere eseguita %2$@; ultimo successo %3$@%4$@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スケジュール実行が期限を過ぎています — %1$@は%2$@に実行されるはずでした。最後の成功: %3$@%4$@。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Execução agendada atrasada — %@ deveria ter sido executado em %@; último sucesso %@%@."
          }
        }
      }
    },
    "Scheduled runs and the command-line tool write it too." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geplante Läufe und das Befehlszeilenwerkzeug schreiben sie ebenfalls."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
