            "state" : "translated",
            "value" : "Une interface graphique pour l’outil open source"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma interface gráfica para o projeto de código aberto"
          }
        }
      }
    },
    "A Jamf Account integration, recommended for Jamf Cloud." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
