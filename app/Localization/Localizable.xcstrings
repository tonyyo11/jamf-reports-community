    "Jamf Pro holds %lld failed command in total, across these devices and any no longer enrolled. " : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jamf Pro enthält insgesamt %lld fehlgeschlagenen Befehl, verteilt auf diese Geräte und nicht mehr registrierte.  "
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jamf Pro conserva %lld comando fallido en total, entre estos dispositivos y otros que ya no están inscritos. "
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jamf Pro conserve %lld commande en échec au total, sur ces appareils et sur ceux qui ne sont plus inscrits. "
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Jamf Pro mantém %lld comando com falha no total, entre estes dispositivos e outros que não estão mais inscritos. "
          }
        }
      }
    },
