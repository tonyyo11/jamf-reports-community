          }
        }
      }
    },
    "Once a day, stable releases only. Nothing is downloaded or installed." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einmal täglich, nur stabile Releases. Es wird nichts geladen oder installiert."
          }
        },
        "es" : {
