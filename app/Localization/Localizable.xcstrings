          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un EA est obsolète — relancez l’audit mSCP pour que les deux concordent."
          }
        }
      }
    },
    "One per device and update" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine pro Gerät und Update"
          }
