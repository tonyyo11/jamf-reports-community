    "'%@' is not an extension attribute defined in Jamf Pro, so this EA has no sheet." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‚%@‘ ist kein in Jamf Pro definiertes Erweiterungsattribut, daher gibt es dafür kein Tabellenblatt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” no es un atributo de extensión definido en Jamf Pro, por lo que este EA no tiene hoja."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » n’est pas un attribut d’extension défini dans Jamf Pro ; cet EA n’a donc pas de feuille."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'%@' non è un attributo di estensione definito in Jamf Pro, quindi questo EA non ha un foglio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'%@' はJamf Proで定義された拡張属性ではないため、このEAにはシートがありません。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'%@' não é um atributo de extensão definido no Jamf Pro, então este EA não tem planilha."
          }
        }
      }
    },
    "'%@' is not in jamf-cli's profiles, so Jamf Protect fails on every run." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ gehört nicht zu den Profilen von jamf-cli, daher schlägt Jamf Protect bei jedem Lauf fehl."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» no está en los perfiles de jamf-cli, por lo que Jamf Protect falla en cada ejecución."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » ne figure pas parmi les profils de jamf-cli : Jamf Protect échoue donc à chaque exécution."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'%@' non è tra i profili di jamf-cli, quindi Jamf Protect non riesce a ogni esecuzione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」は jamf-cli のプロファイルにないため、Jamf Protect は実行のたびに失敗します。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'%@' não está nos perfis do jamf-cli, então o Jamf Protect falha em toda execução."
          }
        }
      }
    },
    "'%@' is not in jamf-cli's profiles, so Platform API reports fail on every run." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ gehört nicht zu den Profilen von jamf-cli, daher schlagen die Platform-API-Berichte bei jedem Lauf fehl."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» no está en los perfiles de jamf-cli, por lo que los informes de Platform API fallan en cada ejecución."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » ne figure pas parmi les profils de jamf-cli : les rapports Platform API échouent donc à chaque exécution."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'%@' non è tra i profili di jamf-cli, quindi i report della Platform API non riescono a ogni esecuzione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」は jamf-cli のプロファイルにないため、Platform API レポートは実行のたびに失敗します。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'%@' não está nos perfis do jamf-cli, então os relatórios da Platform API falham em toda execução."
          }
        }
      }
    },
    "'%@' is profiles.%@ here and in '%@'. Every rollup counts that tenant twice." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%1$@“ ist hier und in „%3$@“ profiles.%2$@. Jede Zusammenfassung zählt diesen Tenant doppelt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "'%1$@' is profiles.%2$@ here and in '%3$@'. Every rollup counts that tenant twice."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%1$@» es profiles.%2$@ aquí y en «%3$@». Cada consolidación cuenta ese tenant dos veces."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %1$@ » est profiles.%2$@ ici et dans « %3$@ ». Chaque consolidation compte ce tenant deux fois."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'%1$@' è profiles.%2$@ qui e in '%3$@'. Ogni riepilogo conta quel tenant due volte."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%1$@」は、ここと「%3$@」の両方で profiles.%2$@ です。すべての集計でそのテナントが二重にカウントされます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'%1$@' é profiles.%2$@ aqui e em '%3$@'. Cada consolidação conta esse tenant duas vezes."
          }
        }
      }
    },
    "'%@' names no environment ID or tenant ID, so its credential reaches only Jamf Account. No Jamf Pro report can be collected with it, and collecting stops at once." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‚%@‘ enthält weder eine Umgebungs-ID noch eine Mandanten-ID, daher erreichen seine Anmeldedaten nur Jamf Account. Damit kann kein Jamf Pro-Bericht erfasst werden, und die Erfassung wird sofort beendet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” no indica ningún ID de entorno ni ID de tenant, por lo que su credencial solo accede a Jamf Account. Con ella no se puede recopilar ningún informe de Jamf Pro, y la recopilación se detiene de inmediato."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » n’indique ni ID d’environnement ni ID de tenant ; son identifiant n’atteint donc que Jamf Account. Aucun rapport Jamf Pro ne peut être collecté avec lui, et la collecte s’arrête immédiatement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'%@' non indica alcun ID ambiente né ID tenant, quindi la sua credenziale raggiunge solo Jamf Account. Con essa non è possibile raccogliere alcun report Jamf Pro e la raccolta si interrompe subito."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'%@' には環境IDもテナントIDも指定されていないため、その資格情報はJamf Accountにしか到達できません。これではJamf Proのレポートを収集できず、収集はすぐに停止します。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'%@' não indica nenhum ID de ambiente ou de tenant, então sua credencial acessa apenas o Jamf Account. Nenhum relatório do Jamf Pro pode ser coletado com ela, e a coleta é interrompida imediatamente."
          }
        }
      }
    },
    "'%@' reaches %@ and '%@' reaches %@, so Platform API reports are skipped. Choose the Platform profile for this Jamf Pro." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%1$@“ erreicht %2$@ und „%3$@“ erreicht %4$@, daher werden Platform-API-Berichte übersprungen. Wählen Sie das Platform-Profil dieses Jamf Pro."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "'%1$@' reaches %2$@ and '%3$@' reaches %4$@, so Platform API reports are skipped. Choose the Platform profile for this Jamf Pro."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%1$@» llega a %2$@ y «%3$@» llega a %4$@, por lo que se omiten los informes de Platform API. Elija el perfil Platform de este Jamf Pro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %1$@ » atteint %2$@ et « %3$@ » atteint %4$@ : les rapports Platform API sont donc ignorés. Choisissez le profil Platform de ce Jamf Pro."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'%1$@' raggiunge %2$@ e '%3$@' raggiunge %4$@, quindi i report della Platform API vengono saltati. Scegliere il profilo Platform di questo Jamf Pro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%1$@」は %2$@ に、「%3$@」は %4$@ に接続するため、Platform API レポートはスキップされます。この Jamf Pro 用の Platform プロファイルを選択してください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'%1$@' alcança %2$@ e '%3$@' alcança %4$@, então os relatórios da Platform API são ignorados. Escolha o perfil Platform deste Jamf Pro."
          }
        }
      }
    },
