    "Daily NOC view for ops engineers: failures, patch queue, stale devices, check-in anomalies, and group hygiene." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tägliche NOC-Ansicht für Betriebstechniker: Fehler, Patch-Warteschlange, veraltete Geräte, Check-in-Auffälligkeiten und Gruppenpflege."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vista diaria del NOC para ingenieros de operaciones: errores, cola de parches, dispositivos obsoletos, anomalías de registro de actividad e higiene de grupos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
