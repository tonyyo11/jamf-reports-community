    "Posts one short card a day while the background item runs, so you can alert on a day without one." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sendet einmal täglich eine kurze Karte, solange das Hintergrundobjekt läuft, damit Sie bei einem Tag ohne Karte alarmieren können."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Publica una tarjeta breve al día mientras se ejecuta el elemento en segundo plano, para que pueda recibir alertas si falta un día."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Publie une courte carte par jour pendant l’exécution de l’élément en arrière-plan, afin que vous puissiez être alerté en l’absence de carte pour une journée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pubblica una breve scheda al giorno mentre l’elemento in background è in esecuzione, così da poter segnalare un giorno senza."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バックグラウンド項目の実行中は1日1回、短いカードを投稿します。投稿のない日にアラートを出せます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Publica um cartão curto por dia enquanto o item em segundo plano é executado, para que você possa alertar sobre um dia sem ele."
          }
        }
      }
    },
    "Posture" : {
      "localizations" : {
