    },
    "While profiles is set these keys are not read: %@. Delete the lines when every Mac sharing this workspace runs this version." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solange profiles gesetzt ist, werden diese Schlüssel nicht gelesen: %@. Löschen Sie die Zeilen, sobald jeder Mac, der diesen Arbeitsbereich teilt, diese Version ausführt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mientras profiles esté definido, estas claves no se leen: %@. Elimine las líneas cuando todos los Mac que comparten este espacio de trabajo ejecuten esta versión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tant que profiles est défini, ces clés ne sont pas lues : %@. Supprimez ces lignes lorsque chaque Mac partageant cet espace de travail exécute cette version."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finché profiles è impostato, queste chiavi non vengono lette: %@. Eliminare le righe quando ogni Mac che condivide questo spazio di lavoro esegue questa versione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "profiles が設定されている間、次のキーは読み込まれません: %@。このワークスペースを共有するすべての Mac がこのバージョンを実行したら、該当行を削除してください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enquanto profiles estiver definido, estas chaves não são lidas: %@. Exclua as linhas quando todos os Macs que compartilham este espaço de trabalho executarem esta versão."
          }
        }
      }
    },
