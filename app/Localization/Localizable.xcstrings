    "Profile \"%@\" is configured for Platform Gateway auth. Collect runs the Platform API reports for it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Profil „%@“ ist für die Platform-Gateway-Authentifizierung konfiguriert. Die Erfassung führt dafür die Platform-API-Berichte aus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El perfil “%@” está configurado para la autenticación de Platform Gateway. La recopilación ejecuta los informes de Platform API para él."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le profil « %@ » est configuré pour l’authentification Platform Gateway. La collecte exécute pour lui les rapports Platform API."
