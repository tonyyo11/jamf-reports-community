    "Suggest which audit findings to work first and what changed since the previous audit, using on-device intelligence." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schlägt mithilfe der Intelligenz auf dem Gerät vor, welche Befunde der Integritätsprüfung zuerst bearbeitet werden sollten und was sich seit der letzten Prüfung geändert hat."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sugiere qué hallazgos de la auditoría conviene atender primero y qué ha cambiado desde la auditoría anterior, con inteligencia en el dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suggérez les constats d’audit à traiter en premier et ce qui a changé depuis l’audit précédent, à l’aide de l’intelligence sur l’appareil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suggerisce quali rilevamenti dell’audit affrontare per primi e cosa è cambiato dall’audit precedente, con l’intelligenza sul dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オンデバイスインテリジェンスを使って、優先して対処すべきヘルス監査の検出事項と、前回の監査からの変化を提案します。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sugere quais achados da auditoria tratar primeiro e o que mudou desde a auditoria anterior, usando inteligência no dispositivo."
          }
        }
      }
    },
    "Suggest which control and macOS version to work first using on-device intelligence." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schlägt mithilfe der Intelligenz auf dem Gerät vor, welche Kontrolle und welche macOS-Version zuerst bearbeitet werden sollten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sugiere qué control y qué versión de macOS conviene atender primero, con inteligencia en el dispositivo."
