    "%@\nCodesign verification failed — binary may be tampered. Update or reinstall jamf-cli." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nCodesign-Prüfung fehlgeschlagen – die Binary wurde möglicherweise manipuliert. Aktualisieren Sie jamf-cli oder installieren Sie es neu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nHa fallado la verificación de codesign: el binario podría haber sido manipulado. Actualice o reinstale jamf-cli."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nÉchec de la vérification de la signature de code — le binaire a peut-être été altéré. Mettez à jour ou réinstallez jamf-cli."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nVerifica codesign non riuscita: il binario potrebbe essere stato manomesso. Aggiornare o reinstallare jamf-cli."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nコード署名の検証に失敗しました — バイナリが改ざんされている可能性があります。jamf-cliをアップデートまたは再インストールしてください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nFalha na verificação da assinatura de código — o binário pode ter sido adulterado. Atualize ou reinstale o jamf-cli."
          }
        }
      }
    },
    "%@\nOlder than the supported %@ — scheduled collects and backups stop until jamf-cli is updated." : {
