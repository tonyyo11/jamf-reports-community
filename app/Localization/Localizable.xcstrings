          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ningún Mac informa de un valor en la columna de ningún agente configurado. Compruebe en Configuración que cada columna coincida con el nombre de su atributo de extensión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucun Mac ne signale de valeur pour la colonne d’un agent configuré. Vérifiez que chaque colonne correspond au nom de son attribut d’extension dans Config."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nenhum Mac relata um valor para a coluna de algum agente configurado. Verifique se cada coluna corresponde ao nome do atributo de extensão em Config."
          }
        }
      }
    },
    "No Macs in this environment." : {
