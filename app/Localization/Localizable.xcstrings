          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Only %1$lld%% of '%2$@' values parse (%3$lld of %4$lld)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo el %lld%% de los valores de '%@' se interpretan (%lld de %lld)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seulement %1$lld%% des valeurs de « %2$@ » sont analysables (%3$lld sur %4$lld)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo il %lld%% dei valori di “%@” è interpretabile (%lld su %lld)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%2$@”の値のうち解析できるのは%1$lld%%のみです（%3$lld/%4$lld）。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apenas %lld%% dos valores de '%@' são interpretados (%lld de %lld)."
          }
        }
      }
    },
    "Only Jamf Protect or Jamf Security Cloud? Jamf Reports reports on a Jamf Pro or Jamf School fleet. Jamf Protect is added to a Jamf Pro or Jamf School workspace, and Jamf Security Cloud is not supported yet." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur Jamf Protect oder Jamf Security Cloud? Jamf Reports erstellt Berichte für eine Jamf-Pro- oder Jamf-School-Flotte. Jamf Protect wird einem Jamf-Pro- oder Jamf-School-Arbeitsbereich hinzugefügt, und Jamf Security Cloud wird noch nicht unterstützt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Solo Jamf Protect o Jamf Security Cloud? Jamf Reports informa sobre una flota de Jamf Pro o Jamf School. Jamf Protect se añade a un espacio de trabajo de Jamf Pro o Jamf School, y Jamf Security Cloud aún no es compatible."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uniquement Jamf Protect ou Jamf Security Cloud ? Jamf Reports établit des rapports sur un parc Jamf Pro ou Jamf School. Jamf Protect s’ajoute à un espace de travail Jamf Pro ou Jamf School, et Jamf Security Cloud n’est pas encore pris en charge."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo Jamf Protect o Jamf Security Cloud? Jamf Reports crea report su un parco dispositivi Jamf Pro o Jamf School. Jamf Protect si aggiunge a uno spazio di lavoro Jamf Pro o Jamf School, mentre Jamf Security Cloud non è ancora supportato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jamf ProtectまたはJamf Security Cloudのみをお使いですか? Jamf ReportsはJamf ProまたはJamf Schoolのフリートを対象にレポートします。Jamf ProtectはJamf ProまたはJamf Schoolのワークスペースに追加でき、Jamf Security Cloudはまだサポートされていません。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Só Jamf Protect ou Jamf Security Cloud? O Jamf Reports gera relatórios de uma frota Jamf Pro ou Jamf School. O Jamf Protect é adicionado a um espaço de trabalho Jamf Pro ou Jamf School, e o Jamf Security Cloud ainda não é compatível."
          }
        }
      }
    },
