    "%lld workspaces could not be created, so nothing was collected for those profiles; each row above names the cause." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld Arbeitsbereiche konnten nicht erstellt werden, daher wurde für diese Profile nichts erfasst; die Ursache steht in der jeweiligen Zeile oben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se han podido crear %lld espacios de trabajo, por lo que no se ha recopilado nada para esos perfiles; cada fila anterior indica la causa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld espaces de travail n’ont pas pu être créés ; rien n’a donc été collecté pour ces profils. Chaque ligne ci-dessus indique la cause."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld espaços de trabalho não puderam ser criados, então nada foi coletado para esses perfis; cada linha acima indica a causa."
          }
        }
      }
    },
