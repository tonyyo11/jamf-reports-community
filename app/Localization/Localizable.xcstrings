    "Other accounts can write to that folder. Remove group and world write access (chmod go-w) or pick another folder." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Andere Accounts können in diesen Ordner schreiben. Entfernen Sie den Schreibzugriff für Gruppe und alle (chmod go-w) oder wählen Sie einen anderen Ordner."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otras cuentas pueden escribir en esa carpeta. Quite el acceso de escritura de grupo y de todos (chmod go-w) o elija otra carpeta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "D’autres comptes peuvent écrire dans ce dossier. Supprimez l’accès en écriture du groupe et de tous (chmod go-w) ou choisissez un autre dossier."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Altri account possono scrivere in quella cartella. Rimuovi l’accesso in scrittura per gruppo e altri (chmod go-w) oppure scegli un’altra cartella."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ほかのアカウントがそのフォルダに書き込めます。グループとその他の書き込み権限を削除する（chmod go-w）か、別のフォルダを選択してください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Outras contas podem gravar nessa pasta. Remova o acesso de gravação para grupo e outros (chmod go-w) ou escolha outra pasta."
          }
        }
      }
