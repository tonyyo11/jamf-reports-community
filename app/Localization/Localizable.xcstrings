    "On: manual refreshes skip the %@, so the screens built on them keep their last cached values until a collect runs them. Scheduled collects still run them." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein: Manuelle Aktualisierungen überspringen %@, sodass die darauf aufbauenden Bildschirme ihre zuletzt zwischengespeicherten Werte behalten, bis eine Erfassung sie ausführt. Geplante Erfassungen führen sie weiterhin aus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activado: las actualizaciones manuales omiten esa parte (%@); las pantallas que dependen de ella conservan sus últimos valores en caché hasta que se ejecute una recopilación. Las recopilaciones programadas siguen ejecutándola."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activé : les actualisations manuelles ignorent %@ ; les écrans qui en dépendent conservent donc leurs dernières valeurs en cache jusqu’à ce qu’une collecte les exécute. Les collectes planifiées les exécutent toujours."
          }
        }
      }
    },
    "Onboarding" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einrichtung"
          }
        },
