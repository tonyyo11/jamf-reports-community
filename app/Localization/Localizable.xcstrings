    "0 of %lld device matched EA column \"%@\" — verify the column name matches your Jamf EA." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "0 von %lld Gerät stimmte mit der EA-Spalte „%@“ überein — prüfen Sie, ob der Spaltenname zu Ihrem Jamf-EA passt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "0 of %1$lld device matched EA column \"%2$@\" — verify the column name matches your Jamf EA."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "0 de %lld dispositivo coincidía con la columna de EA “%@” — compruebe que el nombre de la columna coincide con su EA de Jamf."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
