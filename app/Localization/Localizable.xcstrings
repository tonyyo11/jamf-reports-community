    "Use a Jamf Account integration (Platform API) for Jamf Cloud, or OAuth2 for an on-prem, GovCloud or other Jamf Pro server. You can add Protect later." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwenden Sie eine Jamf Account-Integration (Platform API) für Jamf Cloud oder OAuth2 für einen On-Prem-, GovCloud- oder anderen Jamf Pro-Server. Protect können Sie später hinzufügen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilice una integración de Jamf Account (Platform API) para Jamf Cloud, u OAuth2 para un servidor Jamf Pro local, GovCloud u otro. Puede añadir Protect más tarde."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez une intégration Jamf Account (Platform API) pour Jamf Cloud, ou OAuth2 pour un serveur Jamf Pro sur site, GovCloud ou autre. Vous pourrez ajouter Protect plus tard."
          }
        }
      }
    },
    "Use a folder that already holds %@-style profile workspaces." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwenden Sie einen Ordner, der bereits Arbeitsbereiche im Stil von %@-Profilen enthält."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use una carpeta que ya contenga espacios de trabajo de perfiles de tipo %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez un dossier qui contient déjà des espaces de travail de profils de type %@."
          }
        }
      }
    },
    "Use a name without a line break or tab, that doesn't start or end with a space, and is short enough to be a folder name." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwenden Sie einen Namen ohne Zeilenumbruch oder Tabulator, der nicht mit einem Leerzeichen beginnt oder endet und kurz genug für einen Ordnernamen ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use un nombre sin saltos de línea ni tabuladores, que no empiece ni termine con un espacio y que sea lo bastante corto para ser el nombre de una carpeta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez un nom sans saut de ligne ni tabulation, qui ne commence ni ne finit par une espace, et assez court pour être un nom de dossier."
          }
        }
      }
    },
    "Use a path inside the workspace, or an absolute path with output.allow_absolute_paths: true. System folders are always refused." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwenden Sie einen Pfad innerhalb des Arbeitsbereichs oder einen absoluten Pfad mit output.allow_absolute_paths: true. Systemordner werden immer abgelehnt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use una ruta dentro del espacio de trabajo o una ruta absoluta con output.allow_absolute_paths: true. Las carpetas del sistema se rechazan siempre."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez un chemin dans l’espace de travail, ou un chemin absolu avec output.allow_absolute_paths: true. Les dossiers système sont toujours refusés."
          }
        }
      }
    },
