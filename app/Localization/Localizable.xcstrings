    "Replace the link with a real folder. Alerts, the overdue digest and self-remediation keep working from this Mac's own record meanwhile." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ersetzen Sie den Link durch einen echten Ordner. Warnmeldungen, der Überfälligkeits-Digest und die Selbstreparatur arbeiten in der Zwischenzeit mit dem eigenen Eintrag dieses Mac weiter."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sustituya el enlace por una carpeta real. Mientras tanto, las alertas, el resumen de retrasos y la autorreparación siguen funcionando con el registro propio de este Mac."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remplacez le lien par un vrai dossier. Dans l’intervalle, les alertes, le résumé des retards et l’autoréparation continuent de fonctionner à partir de l’enregistrement propre à ce Mac."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sostituire il collegamento con una cartella reale. Nel frattempo avvisi, digest dei ritardi e autocorrezione continuano a funzionare dal registro di questo Mac."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リンクを実際のフォルダに置き換えてください。それまでの間も、アラート、期限超過ダイジェスト、自己修復はこのMac自身の記録で動作し続けます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Substitua o link por uma pasta real. Enquanto isso, os alertas, o resumo de atrasos e a autocorreção continuam funcionando com o registro deste Mac."
          }
        }
      }
    },
