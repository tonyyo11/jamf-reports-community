    "A %@ login holds no Jamf Pro data, so it is not a workspace. Add Jamf Protect from the Jamf Pro workspace that uses it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Anmeldung bei %@ enthält keine Jamf Pro-Daten und ist daher kein Arbeitsbereich. Fügen Sie Jamf Protect im Jamf Pro-Arbeitsbereich hinzu, der es verwendet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un inicio de sesión de %@ no contiene datos de Jamf Pro, por lo que no es un espacio de trabajo. Añada Jamf Protect desde el espacio de trabajo de Jamf Pro que lo usa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une connexion %@ ne contient aucune donnée Jamf Pro ; ce n’est donc pas un espace de travail. Ajoutez Jamf Protect depuis l’espace de travail Jamf Pro qui l’utilise."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un login %@ non contiene dati Jamf Pro, quindi non è uno spazio di lavoro. Aggiungere Jamf Protect dallo spazio di lavoro Jamf Pro che lo usa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@のログインにはJamf Proのデータがないため、ワークスペースにはなりません。Jamf Protectは、それを使用するJamf Proワークスペースから追加してください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um login do %@ não contém dados do Jamf Pro, então não é um espaço de trabalho. Adicione o Jamf Protect a partir do espaço de trabalho do Jamf Pro que o utiliza."
          }
        }
      }
    },
