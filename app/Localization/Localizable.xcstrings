    "No Homebrew? Download the installer package (.pkg) from the jamf-cli GitHub releases page, run it, then click Re-check above." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kein Homebrew? Laden Sie das Installationspaket (.pkg) von der GitHub-Releases-Seite von jamf-cli herunter, führen Sie es aus und klicken Sie dann oben auf „Erneut prüfen“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿No tiene Homebrew? Descargue el paquete instalador (.pkg) de la página de versiones de jamf-cli en GitHub, ejecútelo y haga clic en Volver a comprobar, arriba."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pas de Homebrew ? Téléchargez le paquet d’installation (.pkg) depuis la page des versions GitHub de jamf-cli, exécutez-le, puis cliquez sur Revérifier ci-dessus."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não usa Homebrew? Baixe o pacote instalador (.pkg) na página de releases do jamf-cli no GitHub, execute-o e clique em Verificar novamente acima."
          }
        }
      }
    },
    "No ID is recorded for this profile." : {
