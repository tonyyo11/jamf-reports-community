        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "'%1$@' coverage fell %2$lld points (%3$lld%% → %4$lld%%)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La cobertura de “%@” ha caído %lld puntos (%lld%% → %lld%%)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » : la couverture a chuté de %lld points (%lld%% → %lld%%)."
