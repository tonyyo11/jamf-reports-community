        }
      }
    },
    "%@ matches no sheet, so the app ignores the whole only list and says so in the run log." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ passt zu keinem Tabellenblatt, daher ignoriert die App die gesamte only-Liste und vermerkt dies im Laufprotokoll."
          }
