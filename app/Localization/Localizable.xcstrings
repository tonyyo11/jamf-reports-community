    "Data protection is off on these devices, usually because no passcode is set. Require a passcode with a configuration profile." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Datenschutz ist auf diesen Geräten deaktiviert, meist weil kein Code festgelegt ist. Verlangen Sie einen Code per Konfigurationsprofil."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La protección de datos está desactivada en estos dispositivos, normalmente porque no hay un código establecido. Exija un código con un perfil de configuración."
