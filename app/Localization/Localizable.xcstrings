        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sugiere qué hallazgos de la auditoría conviene atender primero y qué ha cambiado desde la auditoría anterior, con inteligencia en el dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suggérez les constats d’audit à traiter en premier et ce qui a changé depuis l’audit précédent, à l’aide de l’intelligence sur l’appareil."
          }
        }
      }
