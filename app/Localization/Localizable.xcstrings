        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível ler o arquivo ea-results mais recente, então as linhas de base do mSCP não são exibidas; o proxy de lacunas de controle abaixo as substitui. O arquivo é nomeado em Ajustes › Registro."
          }
        }
      }
