    "Map your compliance failures-list extension attribute (compliance.failures_list_column) in Config, or collect Compliance Benchmarks with a Jamf Platform API profile." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ordnen Sie in der Konfiguration Ihr Erweiterungsattribut für die Liste der Compliance-Fehler (compliance.failures_list_column) zu oder erfassen Sie Compliance-Benchmarks mit einem Jamf Platform API-Profil."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Asigne en Configuración su atributo de extensión de lista de fallos de cumplimiento (compliance.failures_list_column) o recopile Compliance Benchmarks con un perfil de Jamf Platform API."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Associez votre attribut d’extension de liste des échecs de conformité (compliance.failures_list_column) dans Config, ou collectez les référentiels de contrôle de conformité avec un profil Jamf Platform API."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mapeie a extensão de atributo de lista de falhas de conformidade (compliance.failures_list_column) em Config, ou colete Compliance Benchmarks com um perfil da Jamf Platform API."
          }
        }
      }
    },
