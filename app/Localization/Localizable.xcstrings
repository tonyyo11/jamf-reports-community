          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ no es true ni false, así que la app lo lee como false."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ n’est ni true ni false ; l’app le lit comme false."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ não é true nem false, então o app o lê como false."
          }
        }
      }
    },
    "%@ is on a network or synced volume, where the app cannot read who owns the folder or who can write to it. Device inventory and run logs kept here are exposed to any account that can write it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ liegt auf einem Netzwerk- oder synchronisierten Volume, auf dem die App nicht lesen kann, wem der Ordner gehört oder wer darin schreiben darf. Hier abgelegtes Geräteinventar und Laufprotokolle sind für jeden Account sichtbar, der schreiben darf."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ está en un volumen de red o sincronizado, donde la app no puede leer quién es el propietario de la carpeta ni quién puede escribir en ella. El inventario de dispositivos y los registros de ejecución guardados aquí quedan expuestos a cualquier cuenta que pueda escribir en ella."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ se trouve sur un volume réseau ou synchronisé, où l’app ne peut pas lire qui possède le dossier ni qui peut y écrire. L’inventaire des appareils et les journaux d’exécution conservés ici sont exposés à tout compte pouvant y écrire."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ está em um volume de rede ou sincronizado, onde o app não consegue ler quem é o proprietário da pasta nem quem pode gravar nela. O inventário de dispositivos e os logs de execução mantidos aqui ficam expostos a qualquer conta que possa gravar nela."
          }
        }
      }
    },
    "%@ is on in config.yaml but not confirmed here, so backups skip Jamf Pro and read as Partial." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
