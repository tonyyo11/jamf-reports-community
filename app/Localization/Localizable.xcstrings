    "Minimal sends event counts only — no metric values, error text, or schedule names." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Minimal“ sendet nur Ereignisanzahlen – keine Messwerte, Fehlertexte oder Zeitplannamen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El nivel mínimo envía solo recuentos de eventos, sin valores de métricas, texto de errores ni nombres de programaciones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le mode minimal n’envoie que des nombres d’événements, sans valeurs de métriques, texte d’erreur ni noms de planifications."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minimo invia solo il numero di eventi: nessun valore di metrica, testo di errore o nome di pianificazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“最小限”ではイベント数のみを送信します。指標値、エラーテキスト、スケジュール名は含まれません。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O modo mínimo envia apenas contagens de eventos — sem valores de métricas, texto de erro ou nomes de agendamentos."
          }
        }
      }
    },
