          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La parte Jamf Pro dell’ultimo backup non è riuscita, quindi contiene solo ciò che Jamf Protect ha esportato. La Cronologia esecuzioni indica l’errore; Diff confronta i backup di Jamf Pro e salta questo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
