    ". A copied or renamed workspace keeps the old name." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : ". Ein kopierter oder umbenannter Arbeitsbereich behält den alten Namen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : ". Un espacio de trabajo copiado o renombrado conserva el nombre antiguo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : ". Un espace de travail copié ou renommé conserve l’ancien nom."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : ". Uno spazio di lavoro copiato o rinominato mantiene il nome precedente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "。コピーまたは名前変更したワークスペースは、古い名前のままです。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : ". Um espaço de trabalho copiado ou renomeado mantém o nome antigo."
          }
        }
      }
    },
    ". A report made while data is collected would mix old and new figures." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : ". Ein Bericht, der während der Datenerfassung erstellt wird, würde alte und neue Werte mischen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : ". Un informe generado mientras se recopilan datos mezclaría cifras antiguas y nuevas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : ". Un rapport créé pendant la collecte des données mélangerait anciens et nouveaux chiffres."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : ". Un report creato durante la raccolta dei dati mescolerebbe cifre vecchie e nuove."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "。データの収集中にレポートを作成すると、古い値と新しい値が混在します。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : ". Um relatório gerado durante a coleta de dados misturaria números antigos e novos."
          }
        }
      }
    },
    ". Collecting and backing up refuse to run until they agree." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : ". Erfassung und Backup werden verweigert, bis sie übereinstimmen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : ". La recopilación y la copia de seguridad se niegan a ejecutarse hasta que coincidan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : ". La collecte et la sauvegarde refusent de s’exécuter tant qu’ils ne concordent pas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : ". La raccolta e il backup non vengono eseguiti finché non coincidono."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "。両者が一致するまで、収集とバックアップは実行されません。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : ". A coleta e o backup se recusam a rodar até que concordem."
          }
        }
      }
    },
    ". Open Computers to inspect records contributing to this count." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : ". Öffnen Sie „Computer“, um die zu dieser Anzahl beitragenden Datensätze zu prüfen."
          }
