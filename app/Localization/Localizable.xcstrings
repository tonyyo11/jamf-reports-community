    "%@ started %@ %@ and never released it — usually a Mac that slept or was shut down mid-run. It has expired, so the next run here takes it over automatically." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ hat %@ %@ gestartet und nie freigegeben – meist ein Mac, der mitten im Lauf in den Ruhezustand ging oder ausgeschaltet wurde. Die Sperre ist abgelaufen, daher übernimmt der nächste Lauf hier sie automatisch."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ started %2$@ %3$@ and never released it — usually a Mac that slept or was shut down mid-run. It has expired, so the next run here takes it over automatically."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ empezó %@ %@ y nunca la liberó: normalmente un Mac que entró en reposo o se apagó durante la ejecución. Ha caducado, así que la próxima ejecución aquí la asumirá automáticamente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ a démarré %@ %@ et n’a jamais libéré le verrou — en général un Mac mis en veille ou éteint en cours d’exécution. Le verrou a expiré ; la prochaine exécution ici le reprendra automatiquement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ è stato avviato %@ %@ e non è mai stato rilasciato — di solito un Mac andato in stop o spento durante l’esecuzione. È scaduto, quindi la prossima esecuzione qui ne assume automaticamente il controllo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@は%2$@ %3$@に開始され、解放されませんでした — 通常は実行中にスリープまたはシャットダウンしたMacです。有効期限が切れているため、ここでの次回の実行が自動的に引き継ぎます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ iniciou %@ %@ e nunca o liberou — geralmente um Mac que entrou em repouso ou foi desligado durante a execução. Ele expirou, então a próxima execução aqui o assume automaticamente."
          }
        }
      }
    },
