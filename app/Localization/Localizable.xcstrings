        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nenhum Mac relata \"%@\" nos atributos de extensão coletados. Verifique o nome da coluna em Config."
          }
        }
      }
    },
    "No Mac reports a value for any configured agent's column. Check each column matches its extension attribute's name in Config." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
