    "Apple silicon Macs and Intel Macs with the T2 chip always encrypt the internal disk; with FileVault off it unlocks without a password." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple silicon Macs und Intel Macs mit T2-Chip verschlüsseln den internen Datenträger immer; bei ausgeschaltetem FileVault wird er ohne Kennwort entsperrt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los Mac con Apple silicon y los Mac Intel con chip T2 siempre cifran el disco interno; con FileVault desactivado se desbloquea sin contraseña."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les Mac Apple silicon et les Mac Intel dotés de la puce T2 chiffrent toujours le disque interne ; avec FileVault désactivé, il se déverrouille sans mot de passe."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I Mac con Apple silicon e i Mac Intel con chip T2 cifrano sempre il disco interno; con FileVault disattivato si sblocca senza password."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple siliconのMacおよびT2チップ搭載のIntel Macは、内蔵ディスクを常に暗号化します。FileVaultがオフの場合、パスワードなしでロック解除されます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Macs com Apple silicon e Macs Intel com o chip T2 sempre criptografam o disco interno; com o FileVault desativado, ele é desbloqueado sem senha."
          }
        }
      }
    },
