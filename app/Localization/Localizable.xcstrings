    "This wizard creates the workspace folders, registers a jamf-cli profile, writes config.yaml and runs the first report." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Assistent erstellt die Arbeitsbereichsordner, registriert ein jamf-cli-Profil, schreibt config.yaml und führt den ersten Bericht aus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este asistente crea las carpetas del espacio de trabajo, registra un perfil de jamf-cli, escribe config.yaml y ejecuta el primer informe."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cet assistant crée les dossiers de l’espace de travail, enregistre un profil jamf-cli, écrit config.yaml et exécute le premier rapport."
          }
        }
      }
    },
    "This workspace already has Jamf Protect." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Arbeitsbereich hat bereits Jamf Protect."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este espacio de trabajo ya tiene Jamf Protect."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cet espace de travail a déjà Jamf Protect."
          }
        }
      }
    },
    "This workspace has %lld daily summaries; %@ has %lld. Trends and every period-over-period figure read only the folder in use, so the older history is not lost — it is simply not being read." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Arbeitsbereich hat %lld tägliche Zusammenfassungen; %@ hat %lld. Trends und alle Vergleiche zwischen Zeiträumen lesen nur den verwendeten Ordner, der ältere Verlauf geht also nicht verloren — er wird nur nicht gelesen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This workspace has %1$lld daily summaries; %2$@ has %3$lld. Trends and every period-over-period figure read only the folder in use, so the older history is not lost — it is simply not being read."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este espacio de trabajo tiene %lld resúmenes diarios; %@ tiene %lld. Tendencias y todas las cifras comparativas entre periodos solo leen la carpeta en uso, así que el historial anterior no se ha perdido: simplemente no se está leyendo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cet espace de travail compte %lld résumés quotidiens ; %@ en compte %lld. Les tendances et tous les chiffres d’évolution entre périodes ne lisent que le dossier utilisé : l’historique plus ancien n’est donc pas perdu, il n’est simplement pas lu."
          }
        }
      }
    },
    "This workspace has %lld daily summary; %@ has %lld. Trends and every period-over-period figure read only the folder in use, so the older history is not lost — it is simply not being read." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Arbeitsbereich enthält %lld Tageszusammenfassung; %@ enthält %lld. Trends und jeder Periodenvergleich lesen nur den verwendeten Ordner, der ältere Verlauf geht also nicht verloren – er wird nur nicht gelesen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This workspace has %1$lld daily summary; %2$@ has %3$lld. Trends and every period-over-period figure read only the folder in use, so the older history is not lost — it is simply not being read."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este espacio de trabajo tiene %lld resumen diario; %@ tiene %lld. Las tendencias y todas las cifras de comparación entre periodos leen solo la carpeta en uso, por lo que el historial anterior no se ha perdido: simplemente no se está leyendo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cet espace de travail contient %lld synthèse quotidienne ; %@ en contient %lld. Les tendances et chaque chiffre d’une période à l’autre ne lisent que le dossier utilisé : l’historique plus ancien n’est donc pas perdu, il n’est simplement pas lu."
          }
        }
      }
    },
