        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ele é mantido até que a parte do Jamf Protect de um backup posterior seja concluída."
          }
        }
      }
    },
    "Its claim lasts %@. Scheduled runs on this Mac will stand down until then; Refresh still works and will say it is running alongside." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Reservierung gilt %@. Geplante Läufe auf diesem Mac pausieren bis dahin; „Aktualisieren“ funktioniert weiterhin und weist darauf hin, dass es parallel läuft."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Su reserva dura %@. Las ejecuciones programadas en este Mac quedarán en espera hasta entonces; Actualizar sigue funcionando e indicará que se ejecuta en paralelo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Son verrou dure %@. Les exécutions planifiées sur ce Mac s’interrompent jusque-là ; Actualiser fonctionne toujours et indiquera qu’il s’exécute en parallèle."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A reserva dura %@. As execuções agendadas neste Mac ficarão em espera até lá; Atualizar continua funcionando e informará que está sendo executado em paralelo."
          }
        }
      }
    },
