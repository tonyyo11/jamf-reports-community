    "alerts.rules lists %lld rule but alerts.enabled is not set. Alerts are off unless it is true, so no rule runs." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "alerts.rules enthält %lld Regel, aber alerts.enabled ist nicht gesetzt. Alarme sind ohne true deaktiviert, daher läuft keine Regel."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "alerts.rules incluye %lld regla, pero alerts.enabled no está definido. Las alertas están desactivadas salvo que valga true, así que no se ejecuta ninguna regla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "alerts.rules contient %lld règle mais alerts.enabled n’est pas défini. Les alertes sont désactivées sauf si la valeur est true, donc aucune règle ne s’exécute."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "alerts.rules elenca %lld regola ma alerts.enabled non è impostato. Gli avvisi sono disattivati se non è true, quindi nessuna regola viene eseguita."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "alerts.rulesに%lld 件のルールがありますが、alerts.enabledが設定されていません。trueにしない限りアラートは無効のため、どのルールも実行されません。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "alerts.rules lista %lld regra, mas alerts.enabled não está definido. Os alertas ficam desativados a menos que seja true, então nenhuma regra é executada."
