          }
        }
      }
    },
    "This screen renders the once-a-day summary digest, not live inventory. Per-device truth lives on the Computers, Patch, Updates, and posture screens." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Ansicht zeigt die einmal täglich erstellte Zusammenfassung, nicht das Live-Inventar. Die Daten pro Gerät finden Sie in den Ansichten „Computer“, „Patch“, „Updates“ und den Sicherheitsstatus-Ansichten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta pantalla muestra el resumen diario, no el inventario en directo. La información real por dispositivo está en las pantallas Ordenadores, Parches, Actualizaciones y de postura."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cet écran affiche le résumé quotidien, pas l’inventaire en direct. La vérité appareil par appareil se trouve dans les écrans Ordinateurs, Correctifs, Mises à jour et posture."
          }
        }
      }
    },
    "This setup has created:" : {
