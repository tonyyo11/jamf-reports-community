    "FileVault is not scored: every Mac with it off is hardware-encrypted and not counted by this workspace's policy." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FileVault wird nicht gewertet: Alle Macs mit deaktiviertem FileVault sind hardwareverschlüsselt und werden von der Richtlinie dieses Arbeitsbereichs nicht gezählt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FileVault no se puntúa: todos los Mac con FileVault desactivado tienen cifrado por hardware y la política de este espacio de trabajo no los cuenta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FileVault n’est pas évalué : tous les Mac où il est désactivé sont chiffrés par le matériel et ne sont pas comptés par la stratégie de cet espace de travail."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O FileVault não é pontuado: todo Mac com ele desativado tem criptografia de hardware e não é contado pela política deste espaço de trabalho."
          }
        }
      }
    },
