        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suggérez le contrôle et la version de macOS à traiter en premier à l’aide de l’intelligence sur l’appareil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suggerisce quale controllo e quale versione di macOS affrontare per primi con l’intelligenza sul dispositivo."
