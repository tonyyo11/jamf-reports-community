    "Saving re-runs jamf-cli's School setup for this profile, which rebuilds it from these fields: enter all of them, Platform API included, or that access is removed." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beim Sichern wird das Jamf School-Setup von jamf-cli für dieses Profil erneut ausgeführt und das Profil aus diesen Feldern neu aufgebaut: Geben Sie alle Felder ein, einschließlich Platform API, sonst wird dieser Zugriff entfernt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al guardar se vuelve a ejecutar la configuración de School de jamf-cli para este perfil, que lo reconstruye a partir de estos campos: introdúzcalos todos, incluida Platform API, o se eliminará ese acceso."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’enregistrement relance la configuration School de jamf-cli pour ce profil, qui le reconstruit à partir de ces champs : renseignez-les tous, Platform API compris, sinon cet accès est supprimé."
          }
        }
      }
    },
