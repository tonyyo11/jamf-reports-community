            "value" : "A cobertura de '%1$@' caiu %2$lld pontos (%3$lld%% → %4$lld%%)."
          }
        }
      }
    },
    "'%@' has collected values." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‚%@‘ hat erfasste Werte."
