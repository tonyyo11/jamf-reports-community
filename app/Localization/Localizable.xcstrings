    "Off — you manage these schedules yourself. Turn on to let the app keep every profile fresh and generate reports automatically, on one policy." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aus – Sie verwalten diese Zeitpläne selbst. Schalten Sie ein, damit die App jedes Profil aktuell hält und Berichte automatisch mit einer einzigen Richtlinie erstellt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desactivado: usted gestiona estas programaciones. Actívelo para que la app mantenga actualizados todos los perfiles y genere informes automáticamente, con una sola política."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Désactivé — vous gérez vous-même ces planifications. Activez cette option pour que l’app maintienne chaque profil à jour et génère les rapports automatiquement, selon une seule stratégie."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disattivato: le pianificazioni sono gestite manualmente. Attiva per lasciare che l’app mantenga aggiornati tutti i profili e generi i report automaticamente, con un’unica policy."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オフ — スケジュールは手動で管理します。オンにすると、1つのポリシーで全プロファイルを最新に保ち、レポートを自動生成します。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desligado — você mesmo gerencia esses agendamentos. Ative para que o app mantenha cada perfil atualizado e gere relatórios automaticamente, com uma única política."
          }
        }
      }
    },
    "Off. Jamf Reports does not contact GitHub for updates." : {
      "localizations" : {
        "de" : {
