          }
        }
      }
    },
    "Lines this screen could not read inside the blocks it edits are not kept. A copy of the file as it was is at %@." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeilen, die dieser Bildschirm in den bearbeiteten Blöcken nicht lesen konnte, bleiben nicht erhalten. Eine Kopie der Datei im ursprünglichen Zustand liegt unter %@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las líneas que esta pantalla no ha podido leer dentro de los bloques que edita no se conservan. Hay una copia del archivo tal como estaba en %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les lignes que cet écran n’a pas pu lire dans les blocs qu’il modifie ne sont pas conservées. Une copie du fichier d’origine se trouve à l’emplacement %@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le righe che questa schermata non ha potuto leggere nei blocchi che modifica non vengono mantenute. Una copia del file com’era si trova in %@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この画面が編集するブロック内で読み取れなかった行は保持されません。元のファイルのコピーは%@にあります。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As linhas que esta tela não conseguiu ler dentro dos blocos que ela edita não são mantidas. Uma cópia do arquivo como estava fica em %@."
          }
        }
      }
    },
    "List any of: %@. A single word is read as a one-item list." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geben Sie eines von Folgendem an: %@. Ein einzelnes Wort wird als Liste mit einem Eintrag gelesen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indique cualquiera de: %@. Una sola palabra se lee como una lista de un elemento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indiquez un ou plusieurs de ces éléments : %@. Un seul mot est lu comme une liste d’un élément."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elencare uno qualsiasi tra: %@. Una singola parola viene letta come elenco di un solo elemento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "次のいずれかを指定してください: %@。単語1つの場合は、1項目のリストとして読み取られます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liste qualquer um de: %@. Uma única palavra é lida como uma lista de um item."
          }
        }
      }
    },
