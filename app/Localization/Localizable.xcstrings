    "Couldn't write the selections to config.yaml: %@. Verify the workspace config isn't open elsewhere and is writable, then try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Auswahl konnte nicht in config.yaml geschrieben werden: %@. Stellen Sie sicher, dass die Arbeitsbereichskonfiguration nicht anderweitig geöffnet und beschreibbar ist, und versuchen Sie es erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se han podido escribir las selecciones en config.yaml: %@. Compruebe que la configuración del espacio de trabajo no esté abierta en otro lugar y que admita escritura, y vuelva a intentarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible d’écrire les sélections dans config.yaml : %@. Vérifiez que la configuration de l’espace de travail n’est pas ouverte ailleurs et qu’elle est accessible en écriture, puis réessayez."
          }
        }
      }
    },
