    "You can switch between demo data and a real connection anytime from Settings → jamf-cli → Demo mode." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie können jederzeit unter Einstellungen → jamf-cli → Demomodus zwischen Demodaten und einer echten Verbindung wechseln."
          }
