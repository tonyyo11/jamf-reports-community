    "Initializes each workspace, then fetches live jamf-cli data. A few minutes per profile on on-prem servers; faster on cloud." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Initialisiert jeden Arbeitsbereich und ruft dann aktuelle jamf-cli-Daten ab. Einige Minuten pro Profil bei On-Prem-Servern; schneller in der Cloud."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inicializa cada espacio de trabajo y después obtiene datos de jamf-cli en vivo. Unos minutos por perfil en servidores locales; más rápido en la nube."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Initialise chaque espace de travail, puis récupère les données jamf-cli en direct. Quelques minutes par profil sur les serveurs sur site ; plus rapide dans le cloud."
          }
        }
      }
    },
