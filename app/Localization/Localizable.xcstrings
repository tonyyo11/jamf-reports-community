    "On %@ — multi-Mac coordination turns on automatically. Run Check on the Config screen reports who else writes here." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf %@ – die Koordination mehrerer Macs wird automatisch eingeschaltet. „Prüfen“ im Konfig-Bereich zeigt, wer sonst hier schreibt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activado en %@: la coordinación entre varios Mac se activa automáticamente. “Ejecutar comprobación” en la pantalla Configuración indica quién más escribe aquí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activé sur %@ — la coordination multi-Mac s’active automatiquement. Lancez Vérifier sur l’écran Config pour savoir qui d’autre écrit ici."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Su %@ il coordinamento tra più Mac si attiva automaticamente. Esegui Verifica nella schermata Config per sapere chi altro scrive qui."
