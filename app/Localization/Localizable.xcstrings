    "Point output.output_dir at the shared folder too, or set archive_dir back to a local path." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Richten Sie output.output_dir ebenfalls auf den geteilten Ordner oder setzen Sie archive_dir zurück auf einen lokalen Pfad."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apunte output.output_dir también a la carpeta compartida o vuelva a poner archive_dir en una ruta local."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites aussi pointer output.output_dir vers le dossier partagé, ou remettez archive_dir sur un chemin local."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
