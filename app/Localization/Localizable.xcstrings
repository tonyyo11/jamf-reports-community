    "A Jamf Pro backup contains LDAP, SMTP and API-client configuration and scripts that can hold secrets." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Jamf Pro-Backup enthält LDAP-, SMTP- und API-Client-Konfigurationen sowie Skripte, die vertrauliche Daten enthalten können."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una copia de seguridad de Jamf Pro contiene configuración de LDAP, SMTP y clientes de API, y scripts que pueden contener secretos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une sauvegarde Jamf Pro contient la configuration LDAP, SMTP et des clients API, ainsi que des scripts pouvant renfermer des secrets."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un backup di Jamf Pro contiene configurazioni LDAP, SMTP e client API e script che possono contenere segreti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jamf Proのバックアップには、LDAP、SMTP、APIクライアントの設定と、シークレットを含む可能性のあるスクリプトが含まれます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um backup do Jamf Pro contém configurações de LDAP, SMTP e de clientes de API, além de scripts que podem conter segredos."
          }
        }
      }
    },
    "A Jamf Pro server with an API client (OAuth2): on-prem, GovCloud or cloud." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Jamf Pro-Server mit einem API-Client (OAuth2): On-Premise, GovCloud oder Cloud."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un servidor de Jamf Pro con un cliente de API (OAuth2): local, GovCloud o en la nube."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
