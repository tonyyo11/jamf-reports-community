    "Connect Jamf Protect to this workspace with an API client from the Protect console. Its alerts, computers and insights are then collected with the workspace's data." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Binden Sie Jamf Protect mit einem API-Client aus der Protect-Konsole an diesen Arbeitsbereich an. Seine Alarme, Computer und Insights werden dann mit den Daten des Arbeitsbereichs erfasst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conecte Jamf Protect a este espacio de trabajo con un cliente de API de la consola de Protect. Sus alertas, ordenadores y análisis se recopilan junto con los datos del espacio de trabajo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connectez Jamf Protect à cet espace de travail avec un client API de la console Protect. Ses alertes, ordinateurs et analyses sont ensuite collectés avec les données de l’espace de travail."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connettere Jamf Protect a questo spazio di lavoro con un client API della console Protect. I suoi avvisi, computer e insight vengono poi raccolti insieme ai dati dello spazio di lavoro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ProtectコンソールのAPIクライアントを使って、このワークスペースにJamf Protectを接続します。アラート、コンピュータ、インサイトは、ワークスペースのデータとともに収集されます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conecte o Jamf Protect a este espaço de trabalho com um cliente de API do console do Protect. Os alertas, computadores e insights dele passam a ser coletados com os dados do espaço de trabalho."
          }
        }
      }
    },
