    " No workspace exists yet, so there is no dashboard to open. Fix the cause above and try again, or skip for now." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " Es existiert noch kein Arbeitsbereich, daher gibt es kein Dashboard zum Öffnen. Beheben Sie die Ursache oben und versuchen Sie es erneut, oder überspringen Sie den Schritt vorerst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " Todavía no existe ningún espacio de trabajo, así que no hay panel que abrir. Corrija la causa indicada arriba y vuelva a intentarlo, u omita este paso por ahora."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " Aucun espace de travail n’existe encore, donc il n’y a pas de tableau de bord à ouvrir. Corrigez la cause ci-dessus et réessayez, ou ignorez pour l’instant."
          }
        }
      }
    },
    " Previous config (%@) saved as %@; re-run the CSV → EA guide and Columns scaffold to rebuild from your CSV." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " Vorherige Konfiguration (%@) als %@ gesichert; führen Sie die Anleitung „CSV → EA“ und das Spalten-Scaffold erneut aus, um sie aus Ihrer CSV neu aufzubauen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : " Previous config (%1$@) saved as %2$@; re-run the CSV → EA guide and Columns scaffold to rebuild from your CSV."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " Configuración anterior (%@) guardada como %@; vuelva a ejecutar la guía de CSV → EA y la generación base de Columns para reconstruirla a partir del CSV."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " Ancienne configuration (%@) enregistrée sous %@ ; relancez le guide CSV → EA et la génération de colonnes pour reconstruire à partir de votre CSV."
          }
        }
      }
    },
