        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fügen Sie ein Platform-Profil hinzu, das jamf-cli bereits hat. Es muss das Jamf Pro dieses Arbeitsbereichs erreichen. Die Platform-Berichte werden mit diesem Arbeitsbereich erfasst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añada un perfil de Platform que jamf-cli ya tenga. Debe llegar al Jamf Pro de este espacio de trabajo. Los informes de Platform se recopilan con este espacio de trabajo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
