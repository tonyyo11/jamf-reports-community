    "Use a Jamf Account integration (Platform API) for Jamf Cloud, or OAuth2 for an on-prem, GovCloud or other Jamf Pro server. You can add Protect later." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwenden Sie eine Jamf Account-Integration (Platform API) für Jamf Cloud oder OAuth2 für einen On-Prem-, GovCloud- oder anderen Jamf Pro-Server. Protect können Sie später hinzufügen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilice una integración de Jamf Account (Platform API) para Jamf Cloud, u OAuth2 para un servidor Jamf Pro local, GovCloud u otro. Puede añadir Protect más tarde."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez une intégration Jamf Account (Platform API) pour Jamf Cloud, ou OAuth2 pour un serveur Jamf Pro sur site, GovCloud ou autre. Vous pourrez ajouter Protect plus tard."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use uma integração do Jamf Account (Platform API) para o Jamf Cloud, ou OAuth2 para um servidor Jamf Pro on-prem, GovCloud ou outro. Você pode adicionar o Protect depois."
          }
        }
      }
    },
    "Use a folder that already holds %@-style profile workspaces." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwenden Sie einen Ordner, der bereits Arbeitsbereiche im Stil von %@-Profilen enthält."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use una carpeta que ya contenga espacios de trabajo de perfiles de tipo %@."
          }
        },
        "fr" : {
          "stringUnit" : {
