            "state" : "translated",
            "value" : "すべてのjamf-cliプロファイルにワークスペースがあります。Terminalで作成したプロファイルは、再確認後にここに表示されます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todo perfil do jamf-cli já tem um espaço de trabalho. Os perfis criados no Terminal aparecem aqui após Verificar novamente."
          }
        }
      }
    },
    "Everyone with access to this %@ folder will be able to read your fleet's device data" : {
      "localizations" : {
        "de" : {
