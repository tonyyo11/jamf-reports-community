    "). Grant it on the integration in Jamf Account, or on the API role for a Jamf Pro privilege." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "). Erteilen Sie sie für die Integration in Jamf Account oder, bei einer Jamf Pro-Berechtigung, für die API-Rolle."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "). Concédalo en la integración de Jamf Account, o en el rol de API para un privilegio de Jamf Pro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "). Accordez-la à l’intégration dans Jamf Account, ou au rôle d’API pour un privilège Jamf Pro."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "). Conceda-a na integração do Jamf Account ou na função de API para um privilégio do Jamf Pro."
          }
        }
      }
