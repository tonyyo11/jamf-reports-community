          "stringUnit" : {
            "state" : "translated",
            "value" : "La carpeta de automatización es un enlace"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le dossier d’automatisation est un lien"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La cartella di automazione è un link"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自動化フォルダがリンクです"
          }
