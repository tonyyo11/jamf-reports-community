    "%@ If a second Mac points at this folder, both will collect the same day's inventory, each will report success for work the other did, and neither will wait for the other to finish writing." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Wenn ein zweiter Mac auf diesen Ordner zeigt, erfassen beide am selben Tag das Inventar, jeder meldet Erfolg für Arbeit, die der andere erledigt hat, und keiner wartet, bis der andere mit dem Schreiben fertig ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Si un segundo Mac apunta a esta carpeta, ambos recopilarán el inventario del mismo día, cada uno informará de que ha tenido éxito en un trabajo que ha hecho el otro, y ninguno esperará a que el otro termine de escribir."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Si un second Mac pointe vers ce dossier, les deux collecteront l’inventaire du même jour, chacun signalera comme réussi un travail effectué par l’autre, et aucun n’attendra que l’autre ait fini d’écrire."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Se un secondo Mac punta a questa cartella, entrambi raccoglieranno l’inventario dello stesso giorno, ciascuno segnalerà come riuscito un lavoro svolto dall’altro e nessuno attenderà che l’altro finisca di scrivere."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 2台目のMacがこのフォルダを指している場合、両方が同じ日のインベントリを収集し、それぞれが相手の行った作業について成功を報告し、どちらも相手の書き込み完了を待ちません。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Se um segundo Mac apontar para esta pasta, ambos coletarão o inventário do mesmo dia, cada um informará sucesso por um trabalho que o outro realizou e nenhum esperará o outro terminar de gravar."
          }
        }
      }
    },
