    "Connect Jamf Cloud, a Jamf Pro server or Jamf School to build your first workspace, or open the app with demo data to see every screen first." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbinden Sie Jamf Cloud, einen Jamf Pro-Server oder Jamf School, um Ihren ersten Arbeitsbereich zu erstellen, oder öffnen Sie die App mit Demodaten, um zuerst alle Bildschirme zu sehen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conecte Jamf Cloud, un servidor de Jamf Pro o Jamf School para crear su primer espacio de trabajo, o abra la app con datos de demostración para ver antes todas las pantallas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connectez Jamf Cloud, un serveur Jamf Pro ou Jamf School pour créer votre premier espace de travail, ou ouvrez l’app avec des données de démonstration pour découvrir d’abord chaque écran."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connettere Jamf Cloud, un server Jamf Pro o Jamf School per creare il primo spazio di lavoro, oppure aprire l’app con dati demo per vedere prima ogni schermata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jamf Cloud、Jamf Proサーバ、またはJamf Schoolに接続して最初のワークスペースを構築するか、デモデータでアプリを開いてすべての画面を先に確認できます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conecte o Jamf Cloud, um servidor Jamf Pro ou o Jamf School para criar o seu primeiro espaço de trabalho, ou abra o app com dados de demonstração para ver todas as telas antes."
          }
        }
      }
    },
