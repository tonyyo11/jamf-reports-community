    "It is kept until a later backup's Jamf Protect part completes." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es wird aufbewahrt, bis der Jamf Protect-Teil eines späteren Backups abgeschlossen ist."
          }
        },
        "es" : {
