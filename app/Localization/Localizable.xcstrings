    },
    "The %@ credentials were not checked: no answer within %lld seconds." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Anmeldedaten für %@ wurden nicht geprüft: keine Antwort innerhalb von %lld Sekunden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The %1$@ credentials were not checked: no answer within %2$lld seconds."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se han comprobado las credenciales de %@: sin respuesta en %lld segundos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les identifiants de %@ n’ont pas été vérifiés : aucune réponse en %lld secondes."
          }
        }
      }
    },
    "The %@ credentials were not checked: the server is throttling requests." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
