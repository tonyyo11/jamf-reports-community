    "%@ failed: the Jamf Platform gateway rejected this profile's environment or tenant ID. Correct it with Update credentials in Data Sources; the environment ID is in the integration's details in Jamf Account." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ fehlgeschlagen: Das Jamf-Platform-Gateway hat die Umgebungs- oder Mandanten-ID dieses Profils abgelehnt. Korrigieren Sie sie mit „Anmeldedaten aktualisieren“ unter „Datenquellen“; die Umgebungs-ID steht in den Details der Integration in Jamf Account."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ha fallado: la puerta de enlace de Jamf Platform ha rechazado el ID de entorno o de tenant de este perfil. Corríjalo con Actualizar credenciales en Fuentes de datos; el ID de entorno está en los detalles de la integración en Jamf Account."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Échec de %@ : la passerelle Jamf Platform a rejeté l’ID d’environnement ou de tenant de ce profil. Corrigez-le avec Mettre à jour les identifiants dans Sources de données ; l’ID d’environnement figure dans les détails de l’intégration dans Jamf Account."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ falhou: o gateway do Jamf Platform rejeitou o ID de ambiente ou de tenant deste perfil. Corrija em Atualizar credenciais, em Fontes de dados; o ID do ambiente está nos detalhes da integração no Jamf Account."
          }
        }
      }
    },
