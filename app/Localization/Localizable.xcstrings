    "'%@' (Platform API) and '%@' (oauth2) reach the same Jamf Pro server, and both have a workspace. Jamf Reports collects one profile per fleet, so history is split across two folders and a consolidated report counts the fleet twice." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‚%@‘ (Platform API) und ‚%@‘ (oauth2) erreichen denselben Jamf Pro-Server und haben beide einen Arbeitsbereich. Jamf Reports erfasst ein Profil pro Flotte, daher ist der Verlauf auf zwei Ordner verteilt und ein konsolidierter Bericht zählt die Flotte doppelt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "'%1$@' (Platform API) and '%2$@' (oauth2) reach the same Jamf Pro server, and both have a workspace. Jamf Reports collects one profile per fleet, so history is split across two folders and a consolidated report counts the fleet twice."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” (Platform API) y “%@” (oauth2) acceden al mismo servidor de Jamf Pro, y ambos tienen un espacio de trabajo. Jamf Reports recopila un perfil por flota, por lo que el historial se divide en dos carpetas y un informe consolidado cuenta la flota dos veces."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » (Platform API) et « %@ » (oauth2) atteignent le même serveur Jamf Pro et ont chacun un espace de travail. Jamf Reports collecte un profil par parc ; l’historique est donc réparti dans deux dossiers et un rapport consolidé compte le parc deux fois."
          }
        }
      }
    },
    "'%@' coverage fell %lld points (%lld%% → %lld%%)." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Abdeckung von ‚%@‘ ist um %lld Punkte gesunken (%lld%% → %lld%%)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "'%1$@' coverage fell %2$lld points (%3$lld%% → %4$lld%%)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La cobertura de “%@” ha caído %lld puntos (%lld%% → %lld%%)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » : la couverture a chuté de %lld points (%lld%% → %lld%%)."
          }
        }
      }
    },
    "'%@' has collected values." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‚%@‘ hat erfasste Werte."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” tiene valores recopilados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » a des valeurs collectées."
          }
        }
      }
    },
    "'%@' is not an extension attribute defined in Jamf Pro, so this EA has no sheet." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‚%@‘ ist kein in Jamf Pro definiertes Erweiterungsattribut, daher gibt es dafür kein Tabellenblatt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” no es un atributo de extensión definido en Jamf Pro, por lo que este EA no tiene hoja."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » n’est pas un attribut d’extension défini dans Jamf Pro ; cet EA n’a donc pas de feuille."
          }
        }
      }
    },
    "'%@' names no Jamf Pro or Jamf School profile" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‚%@‘ verweist auf kein Jamf Pro- oder Jamf School-Profil"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” no designa ningún perfil de Jamf Pro ni de Jamf School"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » ne désigne aucun profil Jamf Pro ni Jamf School"
          }
        }
      }
    },
    "'%@' names no environment ID or tenant ID, so its credential reaches only Jamf Account. No Jamf Pro report can be collected with it, and collecting stops at once." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‚%@‘ enthält weder eine Umgebungs-ID noch eine Mandanten-ID, daher erreichen seine Anmeldedaten nur Jamf Account. Damit kann kein Jamf Pro-Bericht erfasst werden, und die Erfassung wird sofort beendet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” no indica ningún ID de entorno ni ID de tenant, por lo que su credencial solo accede a Jamf Account. Con ella no se puede recopilar ningún informe de Jamf Pro, y la recopilación se detiene de inmediato."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » n’indique ni ID d’environnement ni ID de tenant ; son identifiant n’atteint donc que Jamf Account. Aucun rapport Jamf Pro ne peut être collecté avec lui, et la collecte s’arrête immédiatement."
          }
        }
      }
    },
