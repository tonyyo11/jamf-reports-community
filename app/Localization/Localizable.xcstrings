    "%@ in config.yaml is not a list, so it was left as typed and nothing was written to it. Write each entry as a \"- name:\" list item so the app can read and edit it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ in config.yaml ist keine Liste und wurde daher unverändert gelassen; es wurde nichts hineingeschrieben. Schreiben Sie jeden Eintrag als Listeneintrag „- name:“, damit die App ihn lesen und bearbeiten kann."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ en config.yaml no es una lista, así que se ha dejado tal como estaba y no se ha escrito nada en él. Escriba cada entrada como un elemento de lista “- name:” para que la app pueda leerla y editarla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ dans config.yaml n’est pas une liste ; il a été laissé tel quel et rien n’y a été écrit. Écrivez chaque entrée comme un élément de liste « - name: » afin que l’app puisse le lire et le modifier."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ in config.yaml non è un elenco, quindi è stato lasciato com’era e non vi è stato scritto nulla. Scrivere ogni voce come elemento di elenco \"- name:\" in modo che l’app possa leggerla e modificarla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "config.yamlの%@はリストではないため、入力されたまま残し、何も書き込んでいません。アプリが読み取って編集できるように、各エントリを“- name:”のリスト項目として記述してください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ no config.yaml não é uma lista, então foi mantido como digitado e nada foi gravado. Escreva cada entrada como um item de lista “- name:” para que o app possa ler e editar."
          }
        }
      }
    },
    "%@ in config.yaml is not a set of settings, so it was left as typed and nothing was written. Write its settings indented under \"%@:\", or remove that line." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ in config.yaml ist kein Satz von Einstellungen und wurde daher unverändert gelassen; es wurde nichts geschrieben. Schreiben Sie die Einstellungen eingerückt unter „%@:“ oder entfernen Sie diese Zeile."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ in config.yaml is not a set of settings, so it was left as typed and nothing was written. Write its settings indented under \"%2$@:\", or remove that line."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ en config.yaml no es un conjunto de ajustes, así que se ha dejado tal como estaba y no se ha escrito nada. Escriba sus ajustes con sangría bajo “%@:”, o elimine esa línea."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ dans config.yaml n’est pas un ensemble de réglages ; il a été laissé tel quel et rien n’a été écrit. Écrivez ses réglages en retrait sous « %@: », ou supprimez cette ligne."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ in config.yaml non è un insieme di impostazioni, quindi è stato lasciato com’era e non è stato scritto nulla. Scrivere le impostazioni con rientro sotto \"%@:\", oppure rimuovere quella riga."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "config.yamlの%1$@は設定のまとまりではないため、入力されたまま残し、何も書き込んでいません。設定を“%2$@:”の下にインデントして記述するか、その行を削除してください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ no config.yaml não é um conjunto de configurações, então foi mantido como digitado e nada foi gravado. Escreva as configurações com recuo sob “%@:” ou remova essa linha."
          }
        }
      }
    },
    "%@ is a file, so no workspace can live there." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ist eine Datei, daher kann dort kein Arbeitsbereich liegen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ es un archivo, por lo que no puede haber ningún espacio de trabajo allí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ est un fichier ; aucun espace de travail ne peut s’y trouver."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ è un file, quindi non può contenere uno spazio di lavoro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@はファイルのため、ワークスペースを置けません。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ é um arquivo, portanto nenhum espaço de trabalho pode ficar ali."
          }
        }
      }
    },
    "%@ is a label kept on this Mac for this profile. It does not change what the jamf-cli credentials can do, and nothing in the app is gated on it yet." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ist eine auf diesem Mac gespeicherte Bezeichnung für dieses Profil. Sie ändert nicht, was die jamf-cli-Anmeldedaten können, und bisher hängt nichts in der App davon ab."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ es una etiqueta que se guarda en este Mac para este perfil. No cambia lo que pueden hacer las credenciales de jamf-cli, y nada en la app depende de ella todavía."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ est une étiquette conservée sur ce Mac pour ce profil. Elle ne change pas ce que les identifiants jamf-cli permettent, et rien dans l’app n’en dépend encore."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ è un’etichetta conservata su questo Mac per questo profilo. Non cambia ciò che le credenziali jamf-cli possono fare e per ora nell’app nulla dipende da essa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@は、このプロファイル用にこのMacに保存されるラベルです。jamf-cliの資格情報でできることは変わらず、アプリ内にこれで制限される機能はまだありません。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ é um rótulo mantido neste Mac para este perfil. Ele não altera o que as credenciais do jamf-cli podem fazer, e nada no app depende dele ainda."
          }
        }
      }
    },
    "%@ is a managed automation agent — turn off Manage automation to remove it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ist ein verwalteter Automatisierungs-Agent – deaktivieren Sie „Automatisierung verwalten“, um ihn zu entfernen."
          }
        },
        "es" : {
          "stringUnit" : {
