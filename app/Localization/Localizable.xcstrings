    "Back to the default location. Profiles already in the previous folder stay there — copy them across if you want them here." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zurück zum Standardort. Profile im bisherigen Ordner bleiben dort — kopieren Sie sie hinüber, wenn Sie sie hier haben möchten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Volver a la ubicación predeterminada. Los perfiles de la carpeta anterior permanecen allí; cópielos si desea tenerlos aquí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retour à l’emplacement par défaut. Les profils déjà présents dans le dossier précédent y restent : copiez-les si vous souhaitez les avoir ici."
          }
