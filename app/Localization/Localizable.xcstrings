    "A workspace named %@ already exists, and a name that differs from it only by letter case would share its folder. Choose a different name." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Arbeitsbereich namens %@ existiert bereits, und ein Name, der sich davon nur durch Groß-/Kleinschreibung unterscheidet, würde denselben Ordner nutzen. Wählen Sie einen anderen Namen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ya existe un espacio de trabajo llamado %@, y un nombre que solo se diferencie de él en mayúsculas y minúsculas compartiría su carpeta. Elija otro nombre."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un espace de travail nommé %@ existe déjà, et un nom qui n’en diffère que par la casse partagerait son dossier. Choisissez un autre nom."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esiste già uno spazio di lavoro denominato %@ e un nome che differisce solo per maiuscole e minuscole condividerebbe la stessa cartella. Scegliere un nome diverso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@という名前のワークスペースはすでに存在し、大文字・小文字だけが異なる名前は同じフォルダを共有することになります。別の名前を選んでください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Já existe um espaço de trabalho chamado %@, e um nome que difere dele apenas por maiúsculas e minúsculas compartilharia a mesma pasta. Escolha outro nome."
          }
        }
      }
    },
