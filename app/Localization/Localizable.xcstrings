    "Computers that have not checked in for more than 30 days. Offline Outreach buckets them by how long they have been quiet." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Computer, die seit mehr als 30 Tagen nicht eingecheckt haben. Offline Outreach gruppiert sie danach, wie lange sie inaktiv sind."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ordenadores que no han registrado actividad en más de 30 días. Offline Outreach los agrupa según el tiempo que llevan inactivos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ordinateurs qui ne se sont pas signalés depuis plus de 30 jours. Contact des appareils hors ligne les répartit selon la durée de leur silence."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Computer che non effettuano il check-in da più di 30 giorni. Offline Outreach li suddivide in base al tempo di inattività."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "30日を超えてチェックインしていないコンピュータです。オフラインアウトリーチは、無通信の期間ごとに分類します。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Computadores que não fazem check-in há mais de 30 dias. O Offline Outreach os agrupa pelo tempo de inatividade."
          }
        }
      }
    },
    "Computers with no %@ for more than this many days are flagged stale." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Computer ohne %@ seit mehr als dieser Anzahl von Tagen gelten als veraltet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los ordenadores sin %@ durante más de este número de días se marcan como obsoletos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les ordinateurs sans %@ depuis plus de ce nombre de jours sont signalés comme obsolètes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I computer senza %@ da più di questo numero di giorni sono contrassegnati come obsoleti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@が指定した日数を超えてないコンピュータは、長期未接続としてフラグが付きます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Computadores sem %@ há mais do que este número de dias são marcados como desatualizados."
          }
        }
      }
    },
