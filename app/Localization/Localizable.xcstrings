    "Lines this screen could not read inside the blocks it edits are not kept. A copy of the file as it was is at %@." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeilen, die dieser Bildschirm in den bearbeiteten Blöcken nicht lesen konnte, bleiben nicht erhalten. Eine Kopie der Datei im ursprünglichen Zustand liegt unter %@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las líneas que esta pantalla no ha podido leer dentro de los bloques que edita no se conservan. Hay una copia del archivo tal como estaba en %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les lignes que cet écran n’a pas pu lire dans les blocs qu’il modifie ne sont pas conservées. Une copie du fichier d’origine se trouve à l’emplacement %@."
