    "Jamf Reports passes the client secret to jamf-cli over stdin and clears it as soon as jamf-cli has saved the profile." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jamf Reports übergibt das Client-Secret über stdin an jamf-cli und löscht es, sobald jamf-cli das Profil gesichert hat."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jamf Reports pasa el secreto de cliente a jamf-cli por stdin y lo borra en cuanto jamf-cli ha guardado el perfil."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jamf Reports transmet le secret client à jamf-cli via stdin et l’efface dès que jamf-cli a enregistré le profil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jamf Reports passa il client secret a jamf-cli tramite stdin e lo cancella non appena jamf-cli ha salvato il profilo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jamf Reportsはクライアントシークレットをstdin経由でjamf-cliに渡し、jamf-cliがプロファイルを保存し次第、消去します。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Jamf Reports passa o segredo do cliente ao jamf-cli por stdin e o apaga assim que o jamf-cli salva o perfil."
          }
        }
      }
    },
