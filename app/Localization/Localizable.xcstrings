            "state" : "translated",
            "value" : "%@ exécute %@"
          }
        }
      }
    },
    "%@ is running %@ in this shared workspace %@. Scheduled runs here wait for it; Refresh still works." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ führt %@ in diesem gemeinsamen Arbeitsbereich %@ aus. Geplante Läufe hier warten darauf; „Aktualisieren“ funktioniert weiterhin."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ is running %2$@ in this shared workspace %3$@. Scheduled runs here wait for it; Refresh still works."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ está ejecutando %@ en este espacio de trabajo compartido %@. Las ejecuciones programadas esperan a que termine; Actualizar sigue funcionando."
          }
        },
        "fr" : {
          "stringUnit" : {
