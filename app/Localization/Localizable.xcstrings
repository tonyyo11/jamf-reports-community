      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ hat eine Erfassung aufgezeichnet, die aus Sicht dieses Mac in der Zukunft liegt. Aktualitätsprüfungen vergleichen diese Zeitstempel, daher wartet dieser Mac möglicherweise weiter, obwohl kürzlich keine Erfassung stattgefunden hat."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ha registrado una recopilación con fecha futura respecto a este Mac. Las comprobaciones de actualidad comparan estas marcas de tiempo, así que este Mac podría seguir cediendo el turno ante una recopilación que en realidad no ha ocurrido recientemente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ a enregistré une collecte datée du futur par rapport à ce Mac. Les contrôles de fraîcheur comparent ces horodatages ; ce Mac risque donc de rester en retrait pour une collecte qui n’a pas eu lieu récemment."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ registrou uma coleta com data no futuro em relação a este Mac. As verificações de atualidade comparam esses carimbos de data e hora, então este Mac pode continuar sem coletar por causa de uma coleta que não aconteceu de fato recentemente."
          }
        }
      }
    },
