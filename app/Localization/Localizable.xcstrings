    },
    "Off — you manage these schedules yourself. Turn on to let the app keep every profile fresh and generate reports automatically, on one policy." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aus – Sie verwalten diese Zeitpläne selbst. Schalten Sie ein, damit die App jedes Profil aktuell hält und Berichte automatisch mit einer einzigen Richtlinie erstellt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desactivado: usted gestiona estas programaciones. Actívelo para que la app mantenga actualizados todos los perfiles y genere informes automáticamente, con una sola política."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Désactivé — vous gérez vous-même ces planifications. Activez cette option pour que l’app maintienne chaque profil à jour et génère les rapports automatiquement, selon une seule stratégie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desligado — você mesmo gerencia esses agendamentos. Ative para que o app mantenha cada perfil atualizado e gere relatórios automaticamente, com uma única política."
          }
        }
      }
    },
    "Off. Jamf Reports does not contact GitHub for updates." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aus. Jamf Reports kontaktiert GitHub nicht für Updates."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desactivado. Jamf Reports no se conecta con GitHub para buscar actualizaciones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Désactivé. Jamf Reports ne contacte pas GitHub pour les mises à jour."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desligado. O Jamf Reports não contata o GitHub para buscar atualizações."
          }
        }
      }
    },
    "Off: every collect runs the %@, which can be slow on a large on-prem server. Turn on to skip them on manual refreshes." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aus: Jede Erfassung führt %@ aus, was auf einem großen On-Prem-Server langsam sein kann. Schalten Sie ein, um sie bei manuellen Aktualisierungen zu überspringen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desactivado: cada recopilación ejecuta %@. Esto puede ser lento en un servidor local grande. Actívelo para omitir esa parte en las actualizaciones manuales."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Désactivé : chaque collecte exécute %@, ce qui peut être lent sur un gros serveur sur site. Activez cette option pour les ignorer lors des actualisations manuelles."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desligado: toda coleta executa %@, o que pode ser lento em um servidor local grande. Ative para ignorá-los nas atualizações manuais."
          }
        }
      }
    },
