    },
    "One EA is out of date — re-run the mSCP audit so both agree." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Erweiterungsattribut ist veraltet – führen Sie das mSCP-Audit erneut aus, damit beide übereinstimmen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
