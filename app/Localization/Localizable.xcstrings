    "Backups are created by scheduled or manual backup runs. Create a restore point before making config changes." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Backups werden durch geplante oder manuelle Backup-Läufe erstellt. Erstellen Sie vor Konfigurationsänderungen einen Wiederherstellungspunkt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las copias de seguridad se crean con ejecuciones de copia programadas o manuales. Cree un punto de restauración antes de cambiar la configuración."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les sauvegardes sont créées par des exécutions de sauvegarde planifiées ou manuelles. Créez un point de restauration avant de modifier la configuration."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os backups são criados por execuções de backup agendadas ou manuais. Crie um ponto de restauração antes de alterar a configuração."
          }
        }
      }
    },
    "Backups from other Macs, and any predating this version, need removing by hand or by running each machine at least once so it prunes its own." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Backups von anderen Macs sowie Backups, die älter als diese Version sind, müssen von Hand entfernt werden, oder jeder Computer muss mindestens einmal laufen, damit er seine eigenen bereinigt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las copias de seguridad de otros Mac, y las anteriores a esta versión, deben eliminarse a mano o ejecutando cada equipo al menos una vez para que depure las suyas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les sauvegardes d’autres Macs, et celles antérieures à cette version, doivent être supprimées à la main ou en exécutant chaque machine au moins une fois pour qu’elle élague les siennes."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os backups de outros Macs, e os anteriores a esta versão, precisam ser removidos manualmente ou executando cada máquina ao menos uma vez para que ela limpe os próprios."
          }
        }
      }
    },
