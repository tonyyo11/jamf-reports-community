    "%@ are not kinds collect can skip, so they skip nothing and the stall guard does not apply to them." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ sind keine Arten, die die Erfassung überspringen kann; sie überspringen daher nichts, und der Stall-Schutz gilt nicht für sie."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ no son tipos que collect pueda omitir, así que no omiten nada y la protección contra bloqueos no se aplica a ellos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ne font pas partie des types que la collecte peut ignorer ; ils n’ignorent donc rien et la protection contre le blocage ne s’y applique pas."
