    "This wizard creates the workspace folders, registers a jamf-cli profile, writes config.yaml and runs the first report." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Assistent erstellt die Arbeitsbereichsordner, registriert ein jamf-cli-Profil, schreibt config.yaml und führt den ersten Bericht aus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este asistente crea las carpetas del espacio de trabajo, registra un perfil de jamf-cli, escribe config.yaml y ejecuta el primer informe."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cet assistant crée les dossiers de l’espace de travail, enregistre un profil jamf-cli, écrit config.yaml et exécute le premier rapport."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
