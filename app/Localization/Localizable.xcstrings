        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A verificação da conexão não conseguiu confirmar o ID%@. Você pode continuar; se as telas continuarem vazias após a primeira coleta, verifique o ID com Atualizar credenciais em Fontes de dados."
          }
