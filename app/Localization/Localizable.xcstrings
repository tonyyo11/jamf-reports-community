    "Automation is off — JamfReports is not allowed to run in the background. Open Automation to fix it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatisierung ist aus — JamfReports darf nicht im Hintergrund laufen. Öffnen Sie „Automatisierung“, um das zu beheben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La automatización está desactivada: JamfReports no tiene permiso para ejecutarse en segundo plano. Abra Automatización para corregirlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’automatisation est désactivée : JamfReports n’est pas autorisé à s’exécuter en arrière-plan. Ouvrez Automatisation pour corriger cela."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’automazione è disattivata — JamfReports non è autorizzato a funzionare in background. Aprire Automazione per risolvere."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自動化はオフです。JamfReportsはバックグラウンドでの実行が許可されていません。自動化を開いて修正してください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A automação está desativada — o JamfReports não tem permissão para ser executado em segundo plano. Abra Automação para corrigir."
          }
        }
      }
    },
    "Automation is off: JamfReports is not allowed to run in the background. Turn it on under Login Items › Allow in the Background." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatisierung ist aus: JamfReports darf nicht im Hintergrund laufen. Aktivieren Sie die App unter Anmeldeobjekte › Im Hintergrund erlauben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La automatización está desactivada: JamfReports no tiene permiso para ejecutarse en segundo plano. Actívelo en Ítems de inicio › Permitir en segundo plano."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’automatisation est désactivée : JamfReports n’est pas autorisé à s’exécuter en arrière-plan. Activez-le dans Ouverture › Autoriser en arrière-plan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’automazione è disattivata: JamfReports non è autorizzato a funzionare in background. Attivarla in Elementi login › Consenti in background."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自動化はオフです。JamfReportsはバックグラウンドでの実行が許可されていません。ログイン項目 › バックグラウンドで許可 でオンにしてください。"
          }
