    "Custom EA reports the full distribution of a column's values. Security Agent checks each device against a single connected / installed value." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eigenes EA meldet die vollständige Verteilung der Werte einer Spalte. Sicherheitsagent prüft jedes Gerät anhand eines einzelnen Werts für „verbunden“ bzw. „installiert“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EA personalizado informa de la distribución completa de los valores de una columna. Agente de seguridad comprueba cada dispositivo con un único valor de conectado o instalado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un EA personnalisé indique la distribution complète des valeurs d’une colonne. Une vérification d’agent de sécurité compare chaque appareil à une seule valeur connecté / installé."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O EA personalizado informa a distribuição completa dos valores de uma coluna. O agente de segurança verifica cada dispositivo com base em um único valor de conectado / instalado."
          }
        }
      }
    },
