          }
        }
      }
    },
    "The workspace folder %@ was not moved to the Trash: %@" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Arbeitsbereichsordner %@ wurde nicht in den Papierkorb gelegt: %@"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The workspace folder %1$@ was not moved to the Trash: %2$@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La carpeta del espacio de trabajo %@ no se ha movido a la Papelera: %@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le dossier d’espace de travail %@ n’a pas été placé dans la Corbeille : %@"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La cartella dello spazio di lavoro %@ non è stata spostata nel Cestino: %@"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ワークスペースフォルダ%@をゴミ箱に移動できませんでした: %@"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A pasta do espaço de trabalho %@ não foi movida para a Lixeira: %@"
          }
        }
      }
    },
    "The workspace folder for '%@' belongs to profile '%@', which differs from it only by letter case, so nothing runs for '%@'. Use '%@', or add this profile again in jamf-cli under a name that differs by more than case." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Arbeitsbereichsordner für „%@“ gehört zum Profil „%@“, das sich nur durch Groß-/Kleinschreibung davon unterscheidet, daher läuft für „%@“ nichts. Verwenden Sie „%@“ oder fügen Sie dieses Profil in jamf-cli erneut unter einem Namen hinzu, der sich um mehr als die Schreibweise unterscheidet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The workspace folder for '%1$@' belongs to profile '%2$@', which differs from it only by letter case, so nothing runs for '%3$@'. Use '%4$@', or add this profile again in jamf-cli under a name that differs by more than case."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La carpeta del espacio de trabajo de “%@” pertenece al perfil “%@”, que solo se diferencia en mayúsculas y minúsculas, así que no se ejecuta nada para “%@”. Use “%@” o vuelva a añadir este perfil en jamf-cli con un nombre que se diferencie en algo más que las mayúsculas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le dossier d’espace de travail de « %@ » appartient au profil « %@ », qui n’en diffère que par la casse ; rien ne s’exécute donc pour « %@ ». Utilisez « %@ », ou ajoutez à nouveau ce profil dans jamf-cli sous un nom qui diffère par autre chose que la casse."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La cartella dello spazio di lavoro per ‘%@’ appartiene al profilo ‘%@’, che differisce solo per maiuscole e minuscole, quindi per ‘%@’ non viene eseguito nulla. Usa ‘%@’ oppure aggiungi di nuovo questo profilo in jamf-cli con un nome che differisca per più delle sole maiuscole e minuscole."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'%1$@' のワークスペースフォルダは、大文字と小文字の違いだけが異なるプロファイル“%2$@”のものであるため、'%3$@' では何も実行されません。'%4$@' を使うか、大文字と小文字以外で異なる名前でこのプロファイルをjamf-cliに追加し直してください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A pasta do espaço de trabalho de '%@' pertence ao perfil '%@', que difere dele apenas por maiúsculas e minúsculas, então nada é executado para '%@'. Use '%@' ou adicione este perfil novamente no jamf-cli com um nome que difira em mais do que maiúsculas e minúsculas."
          }
        }
      }
    },
    "The workspace folder was not found." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Arbeitsbereichsordner wurde nicht gefunden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se ha encontrado la carpeta del espacio de trabajo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le dossier de l’espace de travail est introuvable."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cartella dello spazio di lavoro non trovata."
          }
        },
        "ja" : {
          "stringUnit" : {
