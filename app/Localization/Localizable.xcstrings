    "so a folder created inside one is fine. Otherwise remove it (chmod -N) or pick another folder." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ein darin angelegter Ordner ist daher in Ordnung. Andernfalls entfernen Sie sie (chmod -N) oder wählen Sie einen anderen Ordner."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "por lo que una carpeta creada dentro de una es válida. En caso contrario, elimínela (chmod -N) o elija otra carpeta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "de sorte qu’un dossier créé à l’intérieur convient. Sinon, supprimez-le (chmod -N) ou choisissez un autre dossier."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "quindi una cartella creata al suo interno non pone problemi. In caso contrario, rimuoverla (chmod -N) o scegliere un’altra cartella."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "そのため、その中に作成したフォルダは問題ありません。そうでない場合は削除 （chmod -N） するか、別のフォルダを選んでください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "então uma pasta criada dentro dela não tem problema. Caso contrário, remova-a (chmod -N) ou escolha outra pasta."
          }
        }
      }
