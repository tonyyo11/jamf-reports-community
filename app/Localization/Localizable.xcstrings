    "Several Macs can report against these tenants and build one shared history. %@ Each run is announced with a short claim so two machines do not collect at once." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mehrere Macs können gegen diese Mandanten berichten und einen gemeinsamen Verlauf aufbauen. %@ Jeder Lauf wird mit einem kurzen Claim angekündigt, damit nicht zwei Computer gleichzeitig erfassen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varios Mac pueden informar sobre estos tenants y crear un historial compartido. %@ Cada ejecución se anuncia con una breve reserva para que dos equipos no recopilen a la vez."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plusieurs Mac peuvent produire des rapports sur ces tenants et construire un historique partagé. %@ Chaque exécution est annoncée par une courte réservation pour que deux machines ne collectent pas en même temps."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
