          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ no indican ninguna fecha que la app cuente, así que %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ne désignent aucune date prise en compte par l’app ; %@."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
