    "Run a live diagnosis of the active profile's credentials and server reachability — useful when a collect returns 401 or no data." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Führt eine Live-Diagnose der Anmeldedaten und der Server-Erreichbarkeit des aktiven Profils aus — hilfreich, wenn eine Erfassung 401 oder keine Daten liefert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ejecute un diagnóstico en vivo de las credenciales del perfil activo y de la accesibilidad del servidor; resulta útil cuando una recopilación devuelve 401 o ningún dato."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lance un diagnostic en direct des identifiants du profil actif et de l’accessibilité du serveur, utile quand une collecte renvoie 401 ou aucune donnée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esegue una diagnosi in tempo reale delle credenziali del profilo attivo e della raggiungibilità del server: utile quando una raccolta restituisce 401 o nessun dato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アクティブなプロファイルの資格情報とサーバへの到達性をライブで診断します。collectが401を返す場合や、データが取得できない場合に便利です。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Execute um diagnóstico em tempo real das credenciais do perfil ativo e da acessibilidade do servidor — útil quando uma coleta retorna 401 ou nenhum dado."
          }
        }
      }
    },
