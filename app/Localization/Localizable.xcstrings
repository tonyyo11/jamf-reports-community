    "Experimental: Jamf Protect with Jamf School. Protect is collected and reported; it is not backed up, as a Jamf School workspace has no backups." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Experimentell: Jamf Protect mit Jamf School. Protect wird erfasst und berichtet, aber nicht gesichert, da ein Jamf School-Arbeitsbereich keine Backups hat."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Experimental: Jamf Protect con Jamf School. Protect se recopila y se incluye en los informes, pero no se incluye en las copias de seguridad, ya que un espacio de trabajo de Jamf School no tiene copias de seguridad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
