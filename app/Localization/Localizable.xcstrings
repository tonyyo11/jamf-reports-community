    "Jamf Protect is backed up in this folder, which is %@. Its backups contain action configurations with request headers and data-forwarding settings." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jamf Protect wird in diesem Ordner gesichert, der %@ ist. Die Backups enthalten Aktionskonfigurationen mit Request-Headern und Einstellungen zur Datenweiterleitung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jamf Protect tiene copia de seguridad en esta carpeta, que es %@. Sus copias contienen configuraciones de acciones con encabezados de solicitud y ajustes de reenvío de datos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jamf Protect est sauvegardé dans ce dossier, qui est %@. Ses sauvegardes contiennent des configurations d’action avec des en-têtes de requête et des réglages de transfert de données."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
