    "output.archive_dir points at %@ but output.output_dir does not, so rotated reports leave the machine while current ones stay behind — the opposite of what most people intend." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "output.archive_dir zeigt auf %@, output.output_dir jedoch nicht; rotierte Berichte verlassen also den Rechner, aktuelle bleiben zurück — das Gegenteil dessen, was die meisten beabsichtigen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "output.archive_dir apunta a %@ pero output.output_dir no, de modo que los informes rotados salen del equipo mientras los actuales se quedan — lo contrario de lo que la mayoría pretende."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "output.archive_dir pointe vers %@ mais pas output.output_dir, si bien que les rapports archivés quittent la machine tandis que les rapports actuels y restent — l’inverse de ce que la plupart des gens souhaitent."
          }
        }
      }
    },
    "output.timestamp_authority is not text, so the app reads it as unset. Run manifests are written but not timestamped." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "output.timestamp_authority ist kein Text, daher wird der Wert als nicht gesetzt gelesen. Lauf-Manifeste werden geschrieben, aber nicht mit Zeitstempel versehen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "output.timestamp_authority no es texto, por lo que la app lo lee como no definido. Los manifiestos de ejecución se escriben, pero sin marca de tiempo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "output.timestamp_authority n’est pas du texte ; l’app le lit donc comme non défini. Les manifestes d’exécution sont écrits mais sans horodatage."
          }
        }
      }
    },
    "output.timestamp_authority%@ is not an https:// address. Run manifests are written but not timestamped." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
