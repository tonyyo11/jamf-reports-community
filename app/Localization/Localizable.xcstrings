    "%@ profile '%@' is not carried over; add it to %@ after the merge." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das %1$@-Profil „%2$@“ wird nicht übernommen; fügen Sie es nach dem Zusammenführen zu %3$@ hinzu."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ profile '%2$@' is not carried over; add it to %3$@ after the merge."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El perfil de %1$@ «%2$@» no se traslada; añádalo a %3$@ después de la fusión."
