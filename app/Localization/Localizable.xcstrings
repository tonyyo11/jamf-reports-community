        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Su reserva dura %@. Las ejecuciones programadas en este Mac quedarán en espera hasta entonces; Actualizar sigue funcionando e indicará que se ejecuta en paralelo."
