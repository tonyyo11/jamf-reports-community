    ". A copied or renamed workspace keeps the old name." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : ". Ein kopierter oder umbenannter Arbeitsbereich behält den alten Namen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
