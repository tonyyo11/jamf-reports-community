    "%@ must be a whole number, and \"%@\" is not one, so nothing was saved. Enter a number, or clear the field to use the default." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ muss eine ganze Zahl sein, und „%@“ ist keine; es wurde nichts gesichert. Geben Sie eine Zahl ein oder leeren Sie das Feld, um den Standardwert zu verwenden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ must be a whole number, and \"%2$@\" is not one, so nothing was saved. Enter a number, or clear the field to use the default."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ debe ser un número entero y “%@” no lo es, así que no se ha guardado nada. Introduzca un número o vacíe el campo para usar el valor predeterminado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ doit être un nombre entier et « %@ » n’en est pas un ; rien n’a été enregistré. Saisissez un nombre ou videz le champ pour utiliser la valeur par défaut."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ deve ser um número inteiro, e “%@” não é um, então nada foi salvo. Digite um número ou limpe o campo para usar o padrão."
          }
        }
      }
    },
    "%@ name no date the app counts, so %@." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ nennen kein Datum, das die App zählt, daher %@."
          }
        },
        "en" : {
