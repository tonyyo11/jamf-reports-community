          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jamf Pro indique que ce Mac n’est pas géré et qu’il ne s’est jamais signalé. Il nécessite une intervention manuelle. L’une de ces méthodes installe le binaire :"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jamf Pro elenca questo Mac come non gestito e non ha mai eseguito il check-in. Richiede un intervento manuale. Uno qualsiasi di questi metodi installa il binary:"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jamf ProはこのMacを管理対象外として一覧表示しており、一度もチェックインしていません。手動での対応が必要です。次のいずれかの方法でバイナリを導入できます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Jamf Pro lista este Mac como não gerenciado e ele nunca fez check-in. Ele precisa de intervenção manual. Qualquer uma destas ações instala o binário:"
          }
        }
      }
    },
