        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una fusión en este espacio de trabajo no terminó y su registro no se puede leer. Elija Empezar de nuevo en la tarjeta Entorno antes de volver a fusionar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une fusion dans cet espace de travail ne s’est pas terminée et son historique est illisible. Choisissez Recommencer sur la carte Environnement avant de fusionner à nouveau."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un’unione in questo spazio di lavoro non è stata completata e il suo registro non è leggibile. Scegli Ricomincia nella scheda Ambiente prima di unire di nuovo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このワークスペースへのマージが完了しておらず、その記録を読み取れません。もう一度マージする前に、「環境」カードで「最初からやり直す」を選択してください。"
