    "Add the webhook URL. Nothing is sent until then, the heartbeat included." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fügen Sie die Webhook-URL hinzu. Bis dahin wird nichts gesendet, auch kein Heartbeat."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añada la URL del webhook. No se enviará nada hasta entonces, ni siquiera la señal de actividad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez l’URL du webhook. Rien n’est envoyé d’ici là, signal de présence compris."
