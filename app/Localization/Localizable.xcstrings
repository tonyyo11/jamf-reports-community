    " %lld more has no Jamf binary and is listed on Computers under Binary missing." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " %lld weiterer Mac hat keine Jamf-Binary und wird unter „Computer“ bei „Binary fehlt“ aufgeführt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " %lld más no tiene el binario de Jamf y aparece en Ordenadores, en Binario ausente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " %lld autre n’a pas le binaire Jamf et figure dans Ordinateurs sous Binaire manquant."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " %lld altro non ha il binario Jamf ed è elencato in Computer sotto Binario mancante."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " ほか%lld台はJamfバイナリがなく、コンピュータの“バイナリなし”に一覧表示されています。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " Mais %lld não tem o binário do Jamf e está listado em Computadores, em Binário ausente."
          }
        }
      }
    },
