          "stringUnit" : {
            "state" : "translated",
            "value" : "Une connexion %@ ne contient aucune donnée Jamf Pro ; ce n’est donc pas un espace de travail. Ajoutez Jamf Protect depuis l’espace de travail Jamf Pro qui l’utilise."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um login do %@ não contém dados do Jamf Pro, então não é um espaço de trabalho. Adicione o Jamf Protect a partir do espaço de trabalho do Jamf Pro que o utiliza."
          }
        }
      }
    },
    "A GUI for the open-source" : {
      "localizations" : {
