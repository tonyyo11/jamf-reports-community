          }
        }
      }
    },
    "%@ is not true or false, so the app reads it as false." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ist weder true noch false, daher liest die App es als false."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ no es true ni false, así que la app lo lee como false."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ n’est ni true ni false ; l’app le lit comme false."
          }
        }
      }
    },
    "%@ is on a network or synced volume, where the app cannot read who owns the folder or who can write to it. Device inventory and run logs kept here are exposed to any account that can write it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ liegt auf einem Netzwerk- oder synchronisierten Volume, auf dem die App nicht lesen kann, wem der Ordner gehört oder wer darin schreiben darf. Hier abgelegtes Geräteinventar und Laufprotokolle sind für jeden Account sichtbar, der schreiben darf."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ está en un volumen de red o sincronizado, donde la app no puede leer quién es el propietario de la carpeta ni quién puede escribir en ella. El inventario de dispositivos y los registros de ejecución guardados aquí quedan expuestos a cualquier cuenta que pueda escribir en ella."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ se trouve sur un volume réseau ou synchronisé, où l’app ne peut pas lire qui possède le dossier ni qui peut y écrire. L’inventaire des appareils et les journaux d’exécution conservés ici sont exposés à tout compte pouvant y écrire."
          }
        }
      }
    },
    "%@ is on in config.yaml but not confirmed here, so backups skip Jamf Pro and read as Partial." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ist in config.yaml aktiviert, aber hier nicht bestätigt, daher überspringen Backups Jamf Pro und gelten als „Teilweise“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ está activado en config.yaml pero no confirmado aquí, así que las copias de seguridad omiten Jamf Pro y se leen como Parcial."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ est activé dans config.yaml mais non confirmé ici ; les sauvegardes ignorent donc Jamf Pro et apparaissent comme Partielles."
          }
        }
      }
    },
    "%@ is outside the workspace. The app archives to _archive in the workspace instead." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ liegt außerhalb des Arbeitsbereichs. Die App archiviert stattdessen in _archive im Arbeitsbereich."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ está fuera del espacio de trabajo. La app archiva en _archive dentro del espacio de trabajo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ se trouve en dehors de l’espace de travail. L’app archive dans _archive, dans l’espace de travail, à la place."
          }
        }
      }
    },
    "%@ is running %@" : {
      "localizations" : {
