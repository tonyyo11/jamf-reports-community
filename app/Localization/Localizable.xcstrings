    "Pick the Extension Attributes and security agents collected from Jamf Pro to track in config.yaml. A CSV export can be imported once instead." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wählen Sie die aus Jamf Pro erfassten Erweiterungsattribute und Sicherheitsagents, die in config.yaml verfolgt werden sollen. Stattdessen kann einmalig ein CSV-Export importiert werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elija los atributos de extensión y los agentes de seguridad recopilados de Jamf Pro que se seguirán en config.yaml. En su lugar, puede importar una exportación CSV una sola vez."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez les attributs d’extension et les agents de sécurité collectés depuis Jamf Pro à suivre dans config.yaml. Un export CSV peut être importé une seule fois à la place."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli gli attributi di estensione e gli agenti di sicurezza raccolti da Jamf Pro da monitorare in config.yaml. In alternativa, si può importare una sola volta un export CSV."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "config.yamlで追跡する、Jamf Proから収集された拡張属性とセキュリティエージェントを選択します。代わりにCSVエクスポートを1回だけインポートすることもできます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha os atributos de extensão e agentes de segurança coletados do Jamf Pro para acompanhar no config.yaml. Em vez disso, uma exportação CSV pode ser importada uma vez."
          }
        }
      }
    },
    "Pick the Extension Attributes jamf-cli already collected and adopt them as tracked fields — no manual config editing required." : {
      "localizations" : {
