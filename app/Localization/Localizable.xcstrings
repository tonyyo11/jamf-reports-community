          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los valores parecen recuentos sin procesar. Si este EA contiene recuentos en lugar de porcentajes, cambie su tipo (percentage espera 0–100)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les valeurs ressemblent à des nombres bruts ; si cet EA contient des nombres plutôt que des pourcentages, changez son type (percentage attend 0–100)."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os valores parecem contagens brutas — se este EA contém contagens em vez de porcentagens, altere o tipo dele (percentage espera 0–100)."
