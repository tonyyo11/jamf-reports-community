    "Data protection is off on these devices, usually because no passcode is set. Require a passcode with a configuration profile." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Datenschutz ist auf diesen Geräten deaktiviert, meist weil kein Code festgelegt ist. Verlangen Sie einen Code per Konfigurationsprofil."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La protección de datos está desactivada en estos dispositivos, normalmente porque no hay un código establecido. Exija un código con un perfil de configuración."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La protection des données est désactivée sur ces appareils, généralement faute de code. Exigez un code avec un profil de configuration."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La protezione dei dati è disattivata su questi dispositivi, di solito perché non è impostato alcun codice. Richiedere un codice con un profilo di configurazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これらのデバイスではデータ保護がオフです。多くの場合、パスコードが設定されていないことが原因です。構成プロファイルでパスコードを必須にしてください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A proteção de dados está desativada nestes dispositivos, geralmente porque nenhum código está definido. Exija um código com um perfil de configuração."
          }
        }
      }
    },
