        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use um caminho dentro do espaço de trabalho ou um caminho absoluto com output.allow_absolute_paths: true. Pastas do sistema são sempre recusadas."
