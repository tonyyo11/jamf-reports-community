    "Every jamf-cli profile already has a workspace. Profiles made in Terminal appear here after Re-check." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jedes jamf-cli-Profil hat bereits einen Arbeitsbereich. Im Terminal erstellte Profile erscheinen hier nach „Erneut prüfen“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todos los perfiles de jamf-cli ya tienen un espacio de trabajo. Los perfiles creados en Terminal aparecen aquí tras volver a comprobar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque profil jamf-cli a déjà un espace de travail. Les profils créés dans Terminal apparaissent ici après une nouvelle vérification."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni profilo jamf-cli ha già uno spazio di lavoro. I profili creati in Terminale compaiono qui dopo Ricontrolla."
          }
        },
        "ja" : {
