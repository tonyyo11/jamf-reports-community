    "No Mac reports \"%@\" in the collected extension attributes. Check the column name in Config." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kein Mac meldet „%@“ in den erfassten Erweiterungsattributen. Prüfen Sie den Spaltennamen in der Konfiguration."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
