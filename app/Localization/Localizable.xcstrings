    "%@ data couldn't be collected in the last run — the tenant may not return it (e.g. no update plans). Retry, or check Run History." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@-Daten konnten beim letzten Lauf nicht erfasst werden – der Mandant liefert sie möglicherweise nicht (z. B. keine Update-Pläne). Wiederholen Sie den Vorgang oder prüfen Sie den Laufverlauf."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se han podido recopilar los datos de %@ en la última ejecución: puede que el tenant no los devuelva (p. ej., si no hay planes de actualización). Reintente o consulte el Historial de ejecuciones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les données %@ n’ont pas pu être collectées lors de la dernière exécution — le tenant ne les renvoie peut-être pas (par ex. aucun plan de mise à jour). Réessayez ou consultez l’Historique des exécutions."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non è stato possibile raccogliere i dati %@ nell’ultima esecuzione: il tenant potrebbe non restituirli (ad es. nessun piano di aggiornamento). Riprovare oppure controllare Cronologia esecuzioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "前回の実行で%@のデータを収集できませんでした — テナントがデータを返さない可能性があります（例: アップデートプランなし）。再試行するか、実行履歴を確認してください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível coletar os dados de %@ na última execução — o tenant pode não retorná-los (por exemplo, sem planos de atualização). Tente novamente ou consulte o Histórico de execuções."
          }
        }
      }
    },
    "%@ data is missing or more than %lld days old — Patch, Updates, and EA dashboards show stale values." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@-Daten fehlen oder sind älter als %lld Tage – Patch-, Update- und EA-Dashboards zeigen veraltete Werte."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ data is missing or more than %2$lld days old — Patch, Updates, and EA dashboards show stale values."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los datos de %@ faltan o tienen más de %lld días: los paneles de parches, actualizaciones y EA muestran valores obsoletos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les données %@ sont absentes ou datent de plus de %lld jours — les tableaux de bord Correctifs, Mises à jour et EA affichent des valeurs obsolètes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I dati %@ mancano o hanno più di %lld giorni: le dashboard Patch, Aggiornamenti ed EA mostrano valori obsoleti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@のデータが見つからないか、%lld日以上前のものです — パッチ、アップデート、EAのダッシュボードには古い値が表示されます。"
          }
        },
        "pt-BR" : {
