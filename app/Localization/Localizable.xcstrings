    "Computers that have not checked in for more than 30 days. Offline Outreach buckets them by how long they have been quiet." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Computer, die seit mehr als 30 Tagen nicht eingecheckt haben. Offline Outreach gruppiert sie danach, wie lange sie inaktiv sind."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ordenadores que no han registrado actividad en más de 30 días. Offline Outreach los agrupa según el tiempo que llevan inactivos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ordinateurs qui ne se sont pas signalés depuis plus de 30 jours. Contact des appareils hors ligne les répartit selon la durée de leur silence."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Computadores que não fazem check-in há mais de 30 dias. O Offline Outreach os agrupa pelo tempo de inatividade."
          }
        }
      }
    },
