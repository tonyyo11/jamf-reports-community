    "Jamf Pro backups are turned on in config.yaml but wait for confirmation on this Mac, so they are skipped for now. Turn the switch on here to confirm. %@" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jamf Pro-Backups sind in config.yaml aktiviert, warten aber auf Bestätigung auf diesem Mac und werden daher vorerst übersprungen. Aktivieren Sie hier den Schalter, um zu bestätigen. %@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las copias de seguridad de Jamf Pro están activadas en config.yaml, pero esperan confirmación en este Mac, por lo que se omiten por ahora. Active el interruptor aquí para confirmarlas. %@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les sauvegardes de Jamf Pro sont activées dans config.yaml mais attendent une confirmation sur ce Mac ; elles sont donc ignorées pour le moment. Activez l’option ici pour confirmer. %@"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os backups do Jamf Pro estão ativados em config.yaml, mas aguardam confirmação neste Mac, então foram ignorados por enquanto. Ative a chave aqui para confirmar. %@"
          }
        }
      }
    },
    "Jamf Pro backups are waiting for confirmation on this Mac" : {
