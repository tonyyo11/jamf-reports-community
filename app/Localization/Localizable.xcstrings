    "Decides what counts as a security gap on every screen, report and scheduled run for this workspace. Saved to config.yaml." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legt fest, was in diesem Arbeitsbereich auf jedem Bildschirm, in jedem Bericht und bei jedem geplanten Lauf als Sicherheitslücke gilt. Wird in config.yaml gesichert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Decide qué se considera una brecha de seguridad en todas las pantallas, informes y ejecuciones programadas de este espacio de trabajo. Se guarda en config.yaml."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Définit ce qui compte comme une faille de sécurité sur chaque écran, rapport et exécution planifiée de cet espace de travail. Enregistré dans config.yaml."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stabilisce che cosa costituisce una lacuna di sicurezza in ogni schermata, report ed esecuzione pianificata di questo spazio di lavoro. Salvato in config.yaml."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このワークスペースで、すべての画面、レポート、スケジュール実行におけるセキュリティギャップの判定基準を決めます。config.yamlに保存されます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Define o que conta como lacuna de segurança em todas as telas, relatórios e execuções agendadas deste espaço de trabalho. Salvo em config.yaml."
          }
        }
      }
    },
