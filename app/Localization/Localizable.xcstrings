            "state" : "translated",
            "value" : "完全にこのMac上で実行されます。フリートのデータがデバイスの外に出ることはありません。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Executa inteiramente neste Mac. Nenhum dado da frota sai do dispositivo."
          }
        }
      }
    },
