          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This workspace has %1$lld daily summary; %2$@ has %3$lld. Trends and every period-over-period figure read only the folder in use, so the older history is not lost — it is simply not being read."
          }
        },
        "es" : {
