    "%@ match no sheet, so the app ignores the whole only list and says so in the run log." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ passen zu keinem Tabellenblatt, daher ignoriert die App die gesamte only-Liste und vermerkt dies im Laufprotokoll."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ no coinciden con ninguna hoja, así que la app ignora toda la lista only y lo indica en el registro de ejecución."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ne correspondent à aucune feuille ; l’app ignore donc toute la liste only et l’indique dans le journal d’exécution."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ non corrispondono ad alcun foglio, quindi l’app ignora l’intero elenco only e lo segnala nel log di esecuzione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@に一致するシートがないため、アプリはonlyリスト全体を無視し、実行ログにその旨を記録します。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ não correspondem a nenhuma planilha, então o app ignora toda a lista only e informa isso no log da execução."
          }
        }
      }
    },
    "%@ matches no sheet, so the app ignores it." : {
